---
interface Props {
  src: string;
  lightboxSrc?: string;
  alt: string;
  caption?: string;
  size?: number;
}
const { src, lightboxSrc, alt, caption, size = 80 } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const toFull = (s) => s.startsWith('http') ? s : `${base}${s.startsWith('/') ? s : `/${s}`}`;
const fullThumb = toFull(src);
const fullModal = lightboxSrc ? toFull(lightboxSrc) : fullThumb;
---

<figure class="img-thumb">
  <button class="img-thumb-btn" data-img-src={fullModal} data-img-alt={alt} data-img-caption={caption ?? ''} type="button" aria-label={`이미지 확대: ${alt}`}>
    <img src={fullThumb} alt={alt} width={size} height={size} loading="lazy" decoding="async" />
  </button>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style define:vars={{ thumbSize: `${size}px` }}>
  .img-thumb {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    margin: 0.5rem;
    gap: 0.4rem;
    vertical-align: top;
  }
  .img-thumb-btn {
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    padding: 4px;
    cursor: zoom-in;
    border-radius: 4px;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    line-height: 0;
  }
  .img-thumb-btn:hover,
  .img-thumb-btn:focus-visible {
    transform: scale(1.05);
    border-color: var(--d4-gold, #eac333);
    box-shadow: 0 0 0 1px var(--d4-gold, #eac333), 0 4px 12px rgba(150, 7, 17, 0.35);
    outline: none;
  }
  .img-thumb-btn img {
    width: var(--thumbSize);
    height: var(--thumbSize);
    object-fit: contain;
    display: block;
  }
  .img-thumb figcaption {
    font-size: 0.78em;
    color: var(--sl-color-gray-3);
    text-align: center;
    max-width: calc(var(--thumbSize) + 16px);
    line-height: 1.25;
  }
</style>
