---
interface Props {
  tag: string;
  name: string;
  leader: string;
  createdAt: string;
  size: string;
  description: string;
  labels: string[];
  discord?: string;
  youtubeHandle?: string;
  youtubeChannelName?: string;
}
const {
  tag,
  name,
  leader,
  createdAt,
  size,
  description,
  labels,
  discord,
  youtubeHandle,
  youtubeChannelName,
} = Astro.props as Props;
const youtubeUrl = youtubeHandle
  ? `https://www.youtube.com/@${encodeURIComponent(youtubeHandle)}/live`
  : null;
---

<aside class="clan-profile" aria-labelledby="clan-profile-name">
  <div class="clan-profile-main">
    <div class="clan-profile-header">
      <span class="clan-profile-crest" aria-hidden="true">⚔️</span>
      <div class="clan-profile-titlebox">
        <span class="clan-profile-tag">&lt;{tag}&gt;</span>
        <h3 id="clan-profile-name" class="clan-profile-name">{name}</h3>
        <p class="clan-profile-sub">
          <span class="clan-profile-kind">디아블로4 한국 클랜</span>
          <span class="clan-profile-sep" aria-hidden="true">·</span>
          <span class="clan-profile-leader">클랜장 <strong>{leader}</strong></span>
        </p>
      </div>
    </div>

      <div class="clan-profile-stats">
        <div class="clan-profile-stat">
          <div class="clan-profile-stat-label">📅 생성 날짜</div>
          <div class="clan-profile-stat-value">{createdAt}</div>
        </div>
        <div class="clan-profile-stat">
          <div class="clan-profile-stat-label">👑 클랜장</div>
          <div class="clan-profile-stat-value">{leader}</div>
        </div>
        <div class="clan-profile-stat">
          <div class="clan-profile-stat-label">👥 인원</div>
          <div class="clan-profile-stat-value">{size}</div>
        </div>
      </div>

      <div class="clan-profile-desc">
        <div class="clan-profile-desc-label">📝 가입 안내</div>
        <p set:html={description}></p>
      </div>

      <div class="clan-profile-meta">
        <div class="clan-profile-meta-label">🌍 지역 · 라벨</div>
        <div class="clan-profile-tags">
          {labels.map((l) => (
            <span class="clan-profile-chip">{l}</span>
          ))}
        </div>
      </div>

      <div class="clan-profile-cta">
        {discord && (
          <a class="clan-profile-btn primary" href={discord} target="_blank" rel="noopener noreferrer">
            💬 Discord 입장
          </a>
        )}
        {youtubeUrl && (
          <a class="clan-profile-btn" href={youtubeUrl} target="_blank" rel="noopener noreferrer">
            🎬 클랜장 유튜브 {youtubeChannelName && (<>(<strong>{youtubeChannelName}</strong>)</>)}
          </a>
        )}
      </div>

      {youtubeChannelName && (
        <p class="clan-profile-foot">
          🎬 클랜장 <strong>{leader}</strong> 이(가) 운영하는 유튜브 채널 <strong>{youtubeChannelName}</strong> 에서 디아블로4 시즌 가이드를 다룹니다.
          라이브 방송 시간에 디스코드에 들어오시면 음성으로 가입·빌드·공략 안내를 받으실 수 있습니다.
          위쪽 영상 카드는 <strong>현재 방송 중일 때만 라이브 영상이 임베드</strong>되고, 방송 중이 아니면 채널 홈으로 연결됩니다.
        </p>
      )}
    </div>
</aside>

<style>
  .clan-profile {
    /* Theme-aware tokens — Starlight 토큰 자동 전환 */
    --cp-text: var(--sl-color-text);
    --cp-text-accent: var(--sl-color-text-accent);
    --cp-text-muted: var(--sl-color-gray-3);
    --cp-stat-bg: var(--sl-color-bg-nav);
    --cp-border: var(--sl-color-gray-5);
    --cp-card-shadow: color-mix(in srgb, var(--sl-color-black) 25%, transparent);

    /* Brand 고정 — 다이아블로 핏줄 강조색 (테마 무관) */
    --cp-blood: var(--d4-blood-bright);
    --cp-blood-deep: var(--d4-blood);
    --cp-on-blood: var(--d4-on-blood);

    /* 배경 그라데이션 — d4-blood + sl-color-bg 합성 (테마 자동 추종) */
    --cp-bg-stop-a: color-mix(in srgb, var(--d4-blood) 18%, transparent);
    --cp-bg-stop-b: color-mix(in srgb, var(--sl-color-bg) 70%, transparent);

    margin: 1.25rem 0 1.5rem;
    padding: 1.25rem;
    background: linear-gradient(135deg, var(--cp-bg-stop-a), var(--cp-bg-stop-b));
    border: 1px solid var(--cp-border);
    border-left: 4px solid var(--cp-blood);
    border-radius: 10px;
    box-shadow: 0 6px 18px var(--cp-card-shadow);
    color: var(--cp-text);
  }

  .clan-profile-main {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-width: 0;
  }

  /* Starlight 마크다운 형제 마진 (* + * { margin-top: 1rem }) 이 그리드/플렉스 아이템을
     침범해 균등 높이를 깨는 문제 차단 — 컴포넌트 내부 모든 박스 마진 0 으로 리셋. */
  .clan-profile :where(div, p, span, a, h3, ul, li) {
    margin: 0;
  }

  .clan-profile-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    border-bottom: 1px solid var(--cp-border);
    padding-bottom: 0.7rem;
  }
  .clan-profile-crest {
    font-size: 2.4rem;
    line-height: 1;
    flex: 0 0 auto;
    filter: drop-shadow(0 2px 6px var(--cp-card-shadow));
  }
  .clan-profile-titlebox {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    flex: 1 1 auto;
  }
  .clan-profile-tag {
    font-size: 0.92rem;
    color: var(--cp-text-muted);
    letter-spacing: 0.02em;
  }
  .clan-profile-name {
    margin: 0;
    font-size: 1.7rem;
    line-height: 1.15;
    color: var(--cp-text-accent);
    border-bottom: none;
    padding-bottom: 0;
  }
  .clan-profile-sub {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
    color: var(--cp-text);
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.55rem;
    align-items: baseline;
  }
  .clan-profile-sub .clan-profile-sep { opacity: 0.5; }
  .clan-profile-sub strong { color: var(--cp-text-accent); }

  .clan-profile-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
  }
  @media (max-width: 520px) {
    .clan-profile-stats { grid-template-columns: 1fr; }
  }
  .clan-profile-stat {
    background: var(--cp-stat-bg);
    border: 1px solid var(--cp-border);
    border-radius: 6px;
    padding: 0.55rem 0.7rem;
  }
  .clan-profile-stat-label {
    font-size: 0.78rem;
    color: var(--cp-text-muted);
    margin-bottom: 0.2rem;
  }
  .clan-profile-stat-value {
    font-size: 1rem;
    color: var(--cp-text-accent);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .clan-profile-desc {
    background: var(--cp-stat-bg);
    border: 1px solid var(--cp-border);
    border-radius: 6px;
    padding: 0.65rem 0.85rem;
  }
  .clan-profile-desc-label {
    font-size: 0.8rem;
    color: var(--cp-text-muted);
    margin-bottom: 0.35rem;
    letter-spacing: 0.04em;
  }
  .clan-profile-desc p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--cp-text);
  }
  .clan-profile-desc code {
    background: color-mix(in srgb, var(--cp-text-accent) 12%, transparent);
    color: var(--cp-text-accent);
    padding: 0.05rem 0.4rem;
    border-radius: 3px;
    font-size: 0.85em;
  }

  .clan-profile-meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .clan-profile-meta-label {
    font-size: 0.8rem;
    color: var(--cp-text-muted);
    letter-spacing: 0.04em;
  }
  .clan-profile-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .clan-profile-chip {
    display: inline-block;
    padding: 0.18rem 0.65rem;
    font-size: 0.82rem;
    color: var(--cp-text-accent);
    background: color-mix(in srgb, var(--cp-text-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--cp-text-accent) 50%, transparent);
    border-radius: 4px;
    letter-spacing: 0.02em;
  }

  .clan-profile-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .clan-profile-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--cp-text-accent);
    color: var(--cp-text-accent);
    background: transparent;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .clan-profile-btn:hover {
    background: color-mix(in srgb, var(--cp-text-accent) 16%, transparent);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .clan-profile-btn.primary {
    background: var(--cp-blood);
    border-color: var(--cp-blood);
    color: var(--cp-on-blood);
  }
  .clan-profile-btn.primary:hover {
    background: var(--cp-blood-deep);
    color: var(--cp-on-blood);
  }
  .clan-profile-btn strong { color: inherit; }

  .clan-profile-foot {
    margin: 0;
    padding: 0.65rem 0.85rem;
    background: color-mix(in srgb, var(--cp-blood) 10%, transparent);
    border-left: 3px solid var(--cp-blood);
    border-radius: 0 6px 6px 0;
    font-size: 0.86rem;
    line-height: 1.65;
    color: var(--cp-text);
  }
  .clan-profile-foot strong { color: var(--cp-text-accent); }
</style>
