---
const CHANNEL_HANDLE = 'mimi_BGM';
const CHANNEL_NAME = '미미네음악';
const CHANNEL_URL = `https://www.youtube.com/@${CHANNEL_HANDLE}`;
---

<div id="d4-music-player" class="d4-mp" transition:persist="d4-music-player">
  <button
    type="button"
    class="d4-mp-fab"
    data-role="toggle"
    aria-expanded="false"
    aria-controls="d4-mp-panel"
    aria-label={`${CHANNEL_NAME} 채널 바로가기 펼치기`}
  >
    <span class="d4-mp-fab-icon" aria-hidden="true">🎵</span>
    <span class="d4-mp-fab-label">BGM</span>
  </button>

  <section
    id="d4-mp-panel"
    class="d4-mp-panel"
    data-role="panel"
    aria-label={`${CHANNEL_NAME} 채널 바로가기`}
    hidden
  >
    <header class="d4-mp-head">
      <span class="d4-mp-head-icon" aria-hidden="true">🎵</span>
      <span class="d4-mp-head-title">{CHANNEL_NAME}</span>
      <button type="button" class="d4-mp-close" data-role="close" aria-label="닫기">×</button>
    </header>

    <p class="d4-mp-desc">
      본 사이트의 BGM 채널입니다. 채널에서 직접 음악을 들어보세요.
    </p>

    <a
      class="d4-mp-channel-link"
      href={CHANNEL_URL}
      target="_blank"
      rel="noopener noreferrer"
    >
      🎬 YouTube 채널 바로가기 →
    </a>

    <p class="d4-mp-notice">
      모든 음원의 저작권은 <a href={CHANNEL_URL} target="_blank" rel="noopener noreferrer">{CHANNEL_NAME}</a>에 있습니다.
    </p>
  </section>
</div>

<style>
  .d4-mp {
    --d4-mp-bg: rgba(20, 14, 14, 0.95);
    --d4-mp-border: rgba(234, 195, 51, 0.32);
    --d4-mp-accent: var(--d4-gold);
    --d4-mp-blood: var(--d4-blood);
    --d4-mp-blood-bright: var(--d4-blood-bright);
    --d4-mp-text: var(--d4-bone);
    --d4-mp-shadow: rgba(0, 0, 0, 0.6);
    --d4-mp-btn-hover: rgba(234, 195, 51, 0.24);

    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: var(--d4-z-floating, 9999);
    font-family: inherit;
  }

  /* FAB */
  .d4-mp-fab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 0.95rem;
    background: linear-gradient(135deg, var(--d4-mp-blood-bright), var(--d4-mp-blood));
    color: var(--d4-mp-text);
    border: 1px solid var(--d4-mp-accent);
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.92rem;
    cursor: pointer;
    box-shadow: 0 4px 14px var(--d4-mp-shadow);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .d4-mp-fab:hover { transform: translateY(-1px); box-shadow: 0 6px 18px var(--d4-mp-shadow); }
  .d4-mp-fab:focus-visible { outline: 2px solid var(--d4-mp-accent); outline-offset: 2px; }
  .d4-mp-fab-icon { font-size: 1.1rem; line-height: 1; }
  .d4-mp-fab-label { letter-spacing: 0.04em; }

  /* Panel */
  .d4-mp-panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.65rem);
    width: min(300px, 88vw);
    background: var(--d4-mp-bg);
    border: 1px solid var(--d4-mp-border);
    border-radius: 10px;
    padding: 0.9rem 1rem;
    color: var(--d4-mp-text);
    box-shadow: 0 10px 30px var(--d4-mp-shadow);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .d4-mp-panel[hidden] { display: none; }

  .d4-mp-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--d4-mp-border);
  }
  .d4-mp-head-icon { font-size: 1.15rem; }
  .d4-mp-head-title { flex: 1 1 auto; font-size: 0.95rem; font-weight: 700; color: var(--d4-mp-accent); }
  .d4-mp-close {
    background: transparent;
    border: 1px solid var(--d4-mp-border);
    color: var(--d4-mp-text);
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 6px;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }
  .d4-mp-close:hover { background: var(--d4-mp-btn-hover); }

  .d4-mp-desc {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
  }
  .d4-mp-channel-link {
    display: block;
    padding: 0.55rem 0.8rem;
    background: linear-gradient(135deg, var(--d4-mp-blood-bright), var(--d4-mp-blood));
    border: 1px solid var(--d4-mp-accent);
    color: var(--d4-mp-text);
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 700;
    text-align: center;
  }
  .d4-mp-channel-link:hover { filter: brightness(1.1); }
  .d4-mp-notice {
    margin: 0;
    font-size: 0.74rem;
    line-height: 1.5;
    opacity: 0.85;
  }
  .d4-mp-notice a { color: var(--d4-mp-accent); font-weight: 700; }

  /* Light theme */
  [data-theme='light'] .d4-mp {
    --d4-mp-bg: rgba(255, 252, 245, 0.97);
    --d4-mp-border: rgba(150, 7, 17, 0.32);
    --d4-mp-text: #2a1a08;
    --d4-mp-btn-hover: rgba(234, 195, 51, 0.36);
  }

  @media (max-width: 480px) {
    .d4-mp { right: 0.6rem; bottom: 0.6rem; }
    .d4-mp-fab-label { display: none; }
    .d4-mp-fab { padding: 0.65rem 0.75rem; }
  }
</style>

<script>
  function boot() {
    const root = document.getElementById('d4-music-player') as HTMLElement | null;
    if (!root || root.dataset.d4MpInited === '1') return;
    root.dataset.d4MpInited = '1';

    const panel = root.querySelector<HTMLElement>('[data-role="panel"]');
    const toggleBtn = root.querySelector<HTMLButtonElement>('[data-role="toggle"]');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-role="close"]');
    if (!panel || !toggleBtn) return;

    const setPanel = (open: boolean) => {
      if (open) panel.removeAttribute('hidden');
      else panel.setAttribute('hidden', '');
      toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    toggleBtn.addEventListener('click', () => setPanel(panel.hasAttribute('hidden')));
    closeBtn?.addEventListener('click', () => setPanel(false));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
  document.addEventListener('astro:page-load', boot);
</script>
