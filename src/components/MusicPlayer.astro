---
const CHANNEL_HANDLE = 'mimi_BGM';
const CHANNEL_NAME = '미미네음악';
const PLAYLIST_ID = 'UUHx5Arn_HnKTlA2fG7dhyNw'; // mimi_BGM uploads playlist
const CHANNEL_URL = `https://www.youtube.com/@${CHANNEL_HANDLE}`;
---

<div id="d4-music-player" class="d4-mp" data-playlist={PLAYLIST_ID} transition:persist="d4-music-player">
  <button
    type="button"
    class="d4-mp-fab"
    data-role="toggle"
    aria-expanded="false"
    aria-controls="d4-mp-panel"
    aria-label="BGM 플레이어 열기 — 미미네음악"
  >
    <span class="d4-mp-fab-icon" data-role="fab-icon" aria-hidden="true">🎵</span>
    <span class="d4-mp-fab-label">BGM</span>
    <span class="d4-mp-fab-dot" data-role="fab-dot" aria-hidden="true" hidden></span>
  </button>

  <section
    id="d4-mp-panel"
    class="d4-mp-panel"
    data-role="panel"
    aria-label="BGM 플레이어 — 미미네음악"
    hidden
  >
    <header class="d4-mp-head">
      <span class="d4-mp-head-icon" aria-hidden="true">🎵</span>
      <span class="d4-mp-head-title">BGM — <strong>{CHANNEL_NAME}</strong></span>
      <button type="button" class="d4-mp-close" data-role="close" aria-label="플레이어 닫기">×</button>
    </header>

    <div class="d4-mp-track">
      <p class="d4-mp-track-state" data-role="state">⏸ 정지됨</p>
      <p class="d4-mp-track-name" data-role="track-name">▶ 버튼을 눌러 재생을 시작하세요.</p>
    </div>

    <div class="d4-mp-controls">
      <button type="button" class="d4-mp-btn d4-mp-btn-primary" data-role="play" aria-label="재생/일시정지">
        <span data-role="play-icon">▶</span>
      </button>
      <button type="button" class="d4-mp-btn" data-role="prev" aria-label="이전 곡">⏮</button>
      <button type="button" class="d4-mp-btn" data-role="next" aria-label="다음 곡">⏭</button>
      <button type="button" class="d4-mp-btn" data-role="mute" aria-label="음소거 토글">
        <span data-role="mute-icon">🔊</span>
      </button>
      <label class="d4-mp-vol">
        <span class="sr-only">볼륨</span>
        <input type="range" min="0" max="100" value="40" data-role="volume" aria-label="볼륨" />
        <span class="d4-mp-vol-value" data-role="vol-value">40</span>
      </label>
    </div>

    <footer class="d4-mp-foot">
      <a class="d4-mp-channel-link" href={CHANNEL_URL} target="_blank" rel="noopener noreferrer">
        🎬 YouTube 음악채널 <strong>{CHANNEL_NAME}</strong> 바로가기
      </a>
      <p class="d4-mp-notice">
        본 사이트는 <a href={CHANNEL_URL} target="_blank" rel="noopener noreferrer">{CHANNEL_NAME}</a>의 공식 무료 사용 허가를 받아 BGM 을 송출합니다.
        모든 음원·영상의 저작권과 소유권은 <strong>{CHANNEL_NAME}</strong> 에 있으며, 본 채널 외에서는 사용·재배포할 수 없습니다.
      </p>
    </footer>
  </section>

  <!--
    iframe-host: panel 의 sibling. panel 펼침/접힘 영향 안 받음 → BGM 끊김 0.
    visible area 내 충분한 size 유지 → YouTube 가 광고/콘텐츠 차단 안 함.
    panel 펼친 상태일 때는 panel 위 노출 mini-player, 접힌 상태일 때는 fab 옆 작은 사이즈.
  -->
  <div class="d4-mp-iframe-host" data-role="iframe-host" aria-label="BGM 영상 — 미미네음악"></div>
</div>

<style>
  .d4-mp {
    --d4-mp-bg: rgba(20, 14, 14, 0.95);
    --d4-mp-border: rgba(234, 195, 51, 0.32);
    --d4-mp-accent: var(--d4-gold);
    --d4-mp-blood: var(--d4-blood);
    --d4-mp-blood-bright: var(--d4-blood-bright);
    --d4-mp-text: var(--d4-bone);
    --d4-mp-shadow: rgba(0, 0, 0, 0.6);
    --d4-mp-btn-bg: rgba(234, 195, 51, 0.12);
    --d4-mp-btn-hover: rgba(234, 195, 51, 0.24);

    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: var(--d4-z-floating, 9999);
    font-family: inherit;
  }

  /* Floating action button */
  .d4-mp-fab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 0.95rem;
    background: linear-gradient(135deg, var(--d4-mp-blood-bright), var(--d4-mp-blood));
    color: var(--d4-mp-text);
    border: 1px solid var(--d4-mp-accent);
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.92rem;
    cursor: pointer;
    box-shadow: 0 4px 14px var(--d4-mp-shadow);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    position: relative;
  }
  .d4-mp-fab:hover { transform: translateY(-1px); box-shadow: 0 6px 18px var(--d4-mp-shadow); }
  .d4-mp-fab:focus-visible { outline: 2px solid var(--d4-mp-accent); outline-offset: 2px; }
  .d4-mp-fab-icon { font-size: 1.1rem; line-height: 1; }
  .d4-mp-fab-label { letter-spacing: 0.04em; }
  .d4-mp-fab-dot {
    position: absolute;
    top: 4px;
    right: 6px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--d4-live-dot);
    box-shadow: 0 0 6px var(--d4-live-dot);
    animation: d4-mp-pulse 1.4s ease-in-out infinite;
  }
  @keyframes d4-mp-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.55; transform: scale(0.75); }
  }

  /* Panel */
  .d4-mp-panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.65rem);
    width: min(340px, 88vw);
    background: var(--d4-mp-bg);
    border: 1px solid var(--d4-mp-border);
    border-radius: 10px;
    padding: 0.9rem 1rem 1rem;
    color: var(--d4-mp-text);
    box-shadow: 0 10px 30px var(--d4-mp-shadow);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .d4-mp-panel[hidden] { display: none; }

  .d4-mp-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--d4-mp-border);
  }
  .d4-mp-head-icon { font-size: 1.15rem; }
  .d4-mp-head-title { flex: 1 1 auto; font-size: 0.95rem; }
  .d4-mp-head-title strong { color: var(--d4-mp-accent); }
  .d4-mp-close {
    background: transparent;
    border: 1px solid var(--d4-mp-border);
    color: var(--d4-mp-text);
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 6px;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }
  .d4-mp-close:hover { background: var(--d4-mp-btn-hover); }

  .d4-mp-track {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-height: 2.6rem;
  }
  .d4-mp-track-state {
    margin: 0;
    font-size: 0.78rem;
    color: var(--d4-mp-accent);
    letter-spacing: 0.04em;
    font-weight: 700;
  }
  .d4-mp-track-name {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.4;
    word-break: break-word;
    color: var(--d4-mp-text);
  }

  .d4-mp-controls {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: nowrap;
  }
  .d4-mp-btn {
    flex: 0 0 auto;
    background: var(--d4-mp-btn-bg);
    border: 1px solid var(--d4-mp-border);
    color: var(--d4-mp-text);
    border-radius: 6px;
    width: 2.1rem;
    height: 2.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    cursor: pointer;
    line-height: 1;
    transition: background 0.15s ease, transform 0.1s ease;
  }
  .d4-mp-btn:hover { background: var(--d4-mp-btn-hover); }
  .d4-mp-btn:active { transform: scale(0.94); }
  .d4-mp-btn.d4-mp-btn-primary {
    background: var(--d4-mp-blood);
    border-color: var(--d4-mp-blood-bright);
    color: var(--d4-on-blood);
  }
  .d4-mp-btn.d4-mp-btn-primary:hover { background: var(--d4-mp-blood-bright); }

  .d4-mp-vol {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex: 1 1 auto;
    min-width: 0;
  }
  .d4-mp-vol input[type='range'] {
    flex: 1 1 auto;
    min-width: 0;
    accent-color: var(--d4-mp-accent);
    cursor: pointer;
  }
  .d4-mp-vol-value {
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    color: var(--d4-mp-accent);
    min-width: 2ch;
    text-align: right;
  }

  /*
    iframe-host: panel sibling 으로 분리 → panel 접힘 시에도 audio 끊김 0.
    visible area 내 충분한 size 유지 → YouTube 의 invisible-iframe 광고/콘텐츠 차단 회피.
    panel 접힘 = mini (100x56), panel 펼침 = 표준 (240x135).
  */
  .d4-mp-iframe-host {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.65rem);
    width: 100px;
    height: 56px;
    background: var(--d4-bg-deep);
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--d4-mp-border);
    box-shadow: 0 4px 12px var(--d4-mp-shadow);
    transition: width 0.2s ease, height 0.2s ease;
    z-index: var(--d4-z-base);
  }
  .d4-mp-iframe-host iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  /* panel 펼침 → mini-player 표준 size 로 확장 + panel 을 player 위로 밀어올림 */
  .d4-mp:has(.d4-mp-panel:not([hidden])) .d4-mp-iframe-host {
    width: 240px;
    height: 135px;
  }
  .d4-mp:has(.d4-mp-panel:not([hidden])) .d4-mp-panel {
    bottom: calc(100% + 0.65rem + 135px + 0.5rem);
  }

  .d4-mp-foot {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--d4-mp-border);
  }
  .d4-mp-channel-link {
    display: inline-block;
    padding: 0.45rem 0.7rem;
    background: var(--d4-mp-btn-bg);
    border: 1px solid var(--d4-mp-accent);
    color: var(--d4-mp-accent);
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
    text-align: center;
  }
  .d4-mp-channel-link:hover { background: var(--d4-mp-btn-hover); }
  .d4-mp-channel-link strong { color: inherit; }
  .d4-mp-notice {
    margin: 0;
    font-size: 0.74rem;
    line-height: 1.5;
    color: var(--d4-mp-text);
    opacity: 0.85;
  }
  .d4-mp-notice a {
    color: var(--d4-mp-accent);
    font-weight: 700;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Light theme */
  [data-theme='light'] .d4-mp {
    --d4-mp-bg: rgba(255, 252, 245, 0.97);
    --d4-mp-border: rgba(150, 7, 17, 0.32);
    --d4-mp-text: #2a1a08;
    --d4-mp-btn-bg: rgba(234, 195, 51, 0.2);
    --d4-mp-btn-hover: rgba(234, 195, 51, 0.36);
  }

  /* Compact on small screens */
  @media (max-width: 480px) {
    .d4-mp { right: 0.6rem; bottom: 0.6rem; }
    .d4-mp-fab-label { display: none; }
    .d4-mp-fab { padding: 0.65rem 0.75rem; }
  }
</style>

<script>
  interface YTPlayer {
    playVideo: () => void;
    pauseVideo: () => void;
    nextVideo: () => void;
    previousVideo: () => void;
    setVolume: (v: number) => void;
    getVolume: () => number;
    mute: () => void;
    unMute: () => void;
    isMuted: () => boolean;
    setLoop: (loop: boolean) => void;
    setShuffle: (shuffle: boolean) => void;
    getVideoData: () => { title?: string; video_id?: string; author?: string };
    getPlayerState: () => number;
    destroy: () => void;
  }
  interface YTNamespace {
    Player: new (id: string, opts: Record<string, unknown>) => YTPlayer;
    PlayerState: { UNSTARTED: number; ENDED: number; PLAYING: number; PAUSED: number; BUFFERING: number; CUED: number };
  }
  interface WindowWithYT extends Window {
    YT?: YTNamespace;
    onYouTubeIframeAPIReady?: () => void;
    __d4MpReady?: boolean;
    __d4MpPlayer?: YTPlayer | null;
  }
  const w = window as WindowWithYT;

  const LS_VOLUME = 'd4-mp-volume';
  const LS_MUTED = 'd4-mp-muted';
  const LS_EXPANDED = 'd4-mp-expanded';
  const LS_AUTOPLAY_HINT = 'd4-mp-autoplay-hint';

  let player: YTPlayer | null = null;
  let stateTickerId: number | null = null;
  let titleTickerId: number | null = null;

  function loadIframeApi(): Promise<YTNamespace> {
    if (w.YT && w.YT.Player) return Promise.resolve(w.YT);
    return new Promise((resolve) => {
      const prev = w.onYouTubeIframeAPIReady;
      w.onYouTubeIframeAPIReady = () => {
        if (prev) prev();
        if (w.YT) resolve(w.YT);
      };
      if (!document.querySelector('script[data-d4-yt-api]')) {
        const tag = document.createElement('script');
        tag.src = 'https://www.youtube.com/iframe_api';
        tag.setAttribute('data-d4-yt-api', '1');
        document.head.appendChild(tag);
      }
    });
  }

  function readNum(key: string, fallback: number): number {
    const v = localStorage.getItem(key);
    if (v == null) return fallback;
    const n = Number(v);
    return Number.isFinite(n) ? n : fallback;
  }
  function readBool(key: string, fallback: boolean): boolean {
    const v = localStorage.getItem(key);
    if (v == null) return fallback;
    return v === '1';
  }

  function init(root: HTMLElement) {
    if (root.dataset.d4MpInited === '1') return;
    root.dataset.d4MpInited = '1';

    const playlist = root.dataset.playlist || '';
    const panel = root.querySelector<HTMLElement>('[data-role="panel"]');
    const toggleBtn = root.querySelector<HTMLButtonElement>('[data-role="toggle"]');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-role="close"]');
    const playBtn = root.querySelector<HTMLButtonElement>('[data-role="play"]');
    const playIcon = root.querySelector<HTMLElement>('[data-role="play-icon"]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-role="prev"]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-role="next"]');
    const muteBtn = root.querySelector<HTMLButtonElement>('[data-role="mute"]');
    const muteIcon = root.querySelector<HTMLElement>('[data-role="mute-icon"]');
    const volInput = root.querySelector<HTMLInputElement>('[data-role="volume"]');
    const volValue = root.querySelector<HTMLElement>('[data-role="vol-value"]');
    const iframeHost = root.querySelector<HTMLElement>('[data-role="iframe-host"]');
    const stateEl = root.querySelector<HTMLElement>('[data-role="state"]');
    const trackEl = root.querySelector<HTMLElement>('[data-role="track-name"]');
    const fabDot = root.querySelector<HTMLElement>('[data-role="fab-dot"]');

    if (!panel || !toggleBtn || !playBtn || !volInput || !iframeHost) return;

    const expanded0 = readBool(LS_EXPANDED, false);
    const vol0 = readNum(LS_VOLUME, 40);
    const muted0 = readBool(LS_MUTED, false);

    if (volInput) {
      volInput.value = String(vol0);
      if (volValue) volValue.textContent = String(vol0);
    }
    if (muteIcon) muteIcon.textContent = muted0 ? '🔇' : '🔊';
    setPanel(expanded0);

    function setPanel(open: boolean) {
      if (!panel || !toggleBtn) return;
      if (open) panel.removeAttribute('hidden');
      else panel.setAttribute('hidden', '');
      toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      localStorage.setItem(LS_EXPANDED, open ? '1' : '0');
    }

    function setPlayIcon(playing: boolean) {
      if (playIcon) playIcon.textContent = playing ? '⏸' : '▶';
    }

    function setStateText(playing: boolean) {
      if (stateEl) stateEl.textContent = playing ? '▶ 재생 중' : '⏸ 정지됨';
      if (fabDot) {
        if (playing) fabDot.removeAttribute('hidden');
        else fabDot.setAttribute('hidden', '');
      }
    }

    function refreshTitle() {
      if (!player || !trackEl) return;
      try {
        const data = player.getVideoData();
        if (data && data.title) {
          const author = data.author ? ` — ${data.author}` : '';
          trackEl.textContent = `🎵 ${data.title}${author}`;
        }
      } catch { /* not ready */ }
    }

    async function ensurePlayer() {
      if (player) return player;
      const YT = await loadIframeApi();
      const ph = document.createElement('div');
      ph.id = 'd4-mp-yt-player';
      iframeHost!.appendChild(ph);
      player = new YT.Player('d4-mp-yt-player', {
        host: 'https://www.youtube-nocookie.com',
        height: '180',
        width: '320',
        playerVars: {
          listType: 'playlist',
          list: playlist,
          autoplay: 0,
          controls: 1,
          modestbranding: 1,
          rel: 0,
          playsinline: 1,
          iv_load_policy: 3,
          enablejsapi: 1,
          origin: location.origin,
        },
        events: {
          onReady: (e: { target: YTPlayer }) => {
            const p = e.target;
            p.setShuffle(true);
            p.setLoop(true);
            p.setVolume(vol0);
            if (muted0) p.mute();
            else p.unMute();
            w.__d4MpPlayer = p;
          },
          onStateChange: (e: { data: number; target: YTPlayer }) => {
            const playing = e.data === (YT.PlayerState.PLAYING ?? 1);
            setPlayIcon(playing);
            setStateText(playing);
            refreshTitle();
          },
        },
      });
      w.__d4MpPlayer = player;
      titleTickerId = window.setInterval(refreshTitle, 4000);
      return player;
    }

    toggleBtn.addEventListener('click', () => {
      const open = panel.hasAttribute('hidden');
      setPanel(open);
    });
    closeBtn?.addEventListener('click', () => setPanel(false));

    playBtn.addEventListener('click', async () => {
      const p = await ensurePlayer();
      if (!p) return;
      const state = (() => { try { return p.getPlayerState(); } catch { return -1; } })();
      const playingNow = state === 1;
      if (playingNow) p.pauseVideo();
      else {
        p.playVideo();
        localStorage.setItem(LS_AUTOPLAY_HINT, '1');
      }
    });

    prevBtn?.addEventListener('click', async () => {
      const p = await ensurePlayer();
      try { p.previousVideo(); } catch { /* noop */ }
    });
    nextBtn?.addEventListener('click', async () => {
      const p = await ensurePlayer();
      try { p.nextVideo(); } catch { /* noop */ }
    });

    muteBtn?.addEventListener('click', async () => {
      const p = await ensurePlayer();
      const muted = p.isMuted();
      if (muted) { p.unMute(); localStorage.setItem(LS_MUTED, '0'); if (muteIcon) muteIcon.textContent = '🔊'; }
      else { p.mute(); localStorage.setItem(LS_MUTED, '1'); if (muteIcon) muteIcon.textContent = '🔇'; }
    });

    volInput.addEventListener('input', async () => {
      const v = Number(volInput.value) || 0;
      if (volValue) volValue.textContent = String(v);
      localStorage.setItem(LS_VOLUME, String(v));
      const p = await ensurePlayer();
      try { p.setVolume(v); } catch { /* noop */ }
    });
  }

  function boot() {
    const root = document.getElementById('d4-music-player') as HTMLElement | null;
    if (!root) return;
    init(root);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
  // Astro View Transitions
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => {
    // 위젯은 transition:persist 로 보존됨. 인터벌은 같은 player 유지 시 그대로 OK.
  });
</script>
