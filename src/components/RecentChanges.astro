---
import recentChanges from '../data/recent-changes.json';

interface Props {
  limit?: number;
  compact?: boolean;
}
const { limit = 30, compact = false } = Astro.props as Props;
const items = (recentChanges.items || []).slice(0, limit);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const toFull = (s: string) => s.startsWith('http') ? s : `${base}${s.startsWith('/') ? s : `/${s}`}`;

function fmtDate(iso: string) {
  try {
    const d = new Date(iso);
    return d.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\s/g, '');
  } catch {
    return iso.slice(0, 10);
  }
}
function shortCommit(s: string) {
  // strip "type:" prefix for compact view
  return s.replace(/^[a-z]+(\([^)]+\))?:\s*/, '');
}
---

<div class={`recent-changes ${compact ? 'is-compact' : ''}`} data-recent-changes>
  {!compact && items.length > 0 && (
    <div class="recent-changes-controls">
      <label class="recent-changes-search">
        <span class="recent-changes-search-icon" aria-hidden="true">🔍</span>
        <input
          type="search"
          data-rc-search
          placeholder="문서 제목 또는 커밋 메시지 검색…"
          autocomplete="off"
          spellcheck="false"
        />
        <button type="button" class="recent-changes-search-clear" data-rc-clear aria-label="검색어 지우기" hidden>×</button>
      </label>
      <label class="recent-changes-sort">
        <span class="recent-changes-sort-label">정렬</span>
        <select data-rc-sort>
          <option value="date-desc" selected>최신순 (날짜 ↓)</option>
          <option value="date-asc">오래된순 (날짜 ↑)</option>
          <option value="title-asc">제목 A-Z / ㄱ-ㅎ</option>
          <option value="title-desc">제목 Z-A / ㅎ-ㄱ</option>
          <option value="commit-asc">커밋 메시지 A-Z</option>
        </select>
      </label>
    </div>
  )}

  {items.length === 0 && (
    <p class="recent-changes-empty">변경 내역이 없습니다.</p>
  )}
  {items.length > 0 && (
    <ol class="recent-changes-list" data-rc-list>
      {items.map((it: any) => (
        <li
          class="recent-changes-item"
          data-rc-item
          data-title={it.title}
          data-commit={it.commit}
          data-date={it.date}
        >
          <a class="recent-changes-link" href={toFull(it.url)}>
            <div class="recent-changes-main">
              <span class="recent-changes-title">{it.title}</span>
              <span class="recent-changes-commit" title={it.commit}>{shortCommit(it.commit)}</span>
            </div>
            <div class="recent-changes-meta">
              <time class="recent-changes-date" datetime={it.date}>{fmtDate(it.date)}</time>
              <span class="recent-changes-hash">{it.hash}</span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  )}

  {!compact && items.length > 0 && (
    <p class="recent-changes-status" data-rc-status hidden></p>
  )}

  {!compact && (
    <p class="recent-changes-note">
      마지막 갱신: <time datetime={recentChanges.generatedAt}>{fmtDate(recentChanges.generatedAt)}</time>
      · 총 {recentChanges.count}개 문서
    </p>
  )}
</div>

{!compact && items.length > 0 && (
  <script is:inline>
    (function () {
      const roots = document.querySelectorAll('[data-recent-changes]');
      roots.forEach(function (root) {
        if (root.dataset.rcBound) return;
        root.dataset.rcBound = '1';
        const search = root.querySelector('[data-rc-search]');
        const clearBtn = root.querySelector('[data-rc-clear]');
        const sort = root.querySelector('[data-rc-sort]');
        const list = root.querySelector('[data-rc-list]');
        const status = root.querySelector('[data-rc-status]');
        if (!list) return;

        const allItems = Array.from(list.querySelectorAll('[data-rc-item]'));

        function applyFilter() {
          const q = (search && search.value || '').trim().toLowerCase();
          if (clearBtn) clearBtn.hidden = q.length === 0;
          let visible = 0;
          allItems.forEach(function (it) {
            if (!q) {
              it.hidden = false;
              visible++;
              return;
            }
            const t = (it.dataset.title || '').toLowerCase();
            const c = (it.dataset.commit || '').toLowerCase();
            const match = t.indexOf(q) >= 0 || c.indexOf(q) >= 0;
            it.hidden = !match;
            if (match) visible++;
          });
          if (status) {
            if (q) {
              status.hidden = false;
              status.textContent = '"' + q + '" 결과: ' + visible + '건';
            } else {
              status.hidden = true;
              status.textContent = '';
            }
          }
        }

        function applySort() {
          const v = sort && sort.value || 'date-desc';
          const sorted = allItems.slice().sort(function (a, b) {
            const ta = a.dataset.title || '';
            const tb = b.dataset.title || '';
            const ca = a.dataset.commit || '';
            const cb = b.dataset.commit || '';
            const da = a.dataset.date || '';
            const db = b.dataset.date || '';
            if (v === 'date-asc') return da.localeCompare(db);
            if (v === 'title-asc') return ta.localeCompare(tb, 'ko');
            if (v === 'title-desc') return tb.localeCompare(ta, 'ko');
            if (v === 'commit-asc') return ca.localeCompare(cb, 'ko');
            return db.localeCompare(da); // date-desc default
          });
          sorted.forEach(function (it) { list.appendChild(it); });
        }

        if (search) {
          search.addEventListener('input', applyFilter);
        }
        if (clearBtn) {
          clearBtn.addEventListener('click', function () {
            if (search) {
              search.value = '';
              search.focus();
            }
            applyFilter();
          });
        }
        if (sort) {
          sort.addEventListener('change', applySort);
        }
        applyFilter();
      });
    })();
  </script>
)}

<style>
  .recent-changes-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 6px;
    overflow: hidden;
  }
  .recent-changes-item {
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  .recent-changes-item:last-child { border-bottom: none; }
  .recent-changes-link {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding: 0.7rem 0.95rem;
    color: var(--sl-color-text);
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .recent-changes-link:hover,
  .recent-changes-link:focus-visible {
    background: rgba(234, 195, 51, 0.08);
    outline: none;
  }
  [data-theme='light'] .recent-changes-link:hover,
  [data-theme='light'] .recent-changes-link:focus-visible {
    background: rgba(234, 195, 51, 0.18);
  }
  .recent-changes-main {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    flex: 1;
  }
  .recent-changes-title {
    font-weight: 600;
    color: var(--d4-gold, #eac333);
    font-size: 0.97em;
    line-height: 1.4;
  }
  [data-theme='light'] .recent-changes-title { color: #8a6a00; }
  .recent-changes-commit {
    font-size: 0.83em;
    color: var(--sl-color-gray-2, #c8bda1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    line-height: 1.4;
  }
  [data-theme='light'] .recent-changes-commit { color: #555; }
  .recent-changes-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
    flex: 0 0 auto;
    font-size: 0.78em;
  }
  .recent-changes-date {
    color: var(--sl-color-gray-3);
    font-variant-numeric: tabular-nums;
  }
  .recent-changes-hash {
    color: var(--d4-bone, #d8c8a0);
    font-family: var(--sl-font-mono, ui-monospace, monospace);
    font-size: 0.9em;
    opacity: 0.7;
  }
  .recent-changes-empty {
    color: var(--sl-color-gray-3);
    font-style: italic;
  }
  .recent-changes-note {
    margin-top: 0.85rem;
    font-size: 0.82rem;
    color: var(--sl-color-gray-3);
  }
  .recent-changes-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 0.85rem;
    align-items: center;
  }
  .recent-changes-search {
    position: relative;
    flex: 1 1 16rem;
    min-width: 12rem;
    display: flex;
    align-items: center;
  }
  .recent-changes-search-icon {
    position: absolute;
    left: 0.6rem;
    pointer-events: none;
    font-size: 0.95rem;
    opacity: 0.7;
  }
  .recent-changes-search input {
    flex: 1;
    padding: 0.45rem 2rem 0.45rem 2rem;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 6px;
    color: var(--sl-color-text);
    font-size: 0.92rem;
    font-family: inherit;
    width: 100%;
  }
  .recent-changes-search input:focus {
    outline: none;
    border-color: var(--d4-gold, #eac333);
    box-shadow: 0 0 0 2px rgba(234, 195, 51, 0.18);
  }
  .recent-changes-search input::-webkit-search-cancel-button { display: none; }
  .recent-changes-search-clear {
    position: absolute;
    right: 0.4rem;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--sl-color-text);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0.6;
  }
  .recent-changes-search-clear:hover {
    background: rgba(192, 16, 32, 0.15);
    color: #c01020;
    opacity: 1;
  }
  .recent-changes-sort {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex: 0 0 auto;
  }
  .recent-changes-sort-label {
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
    font-weight: 600;
  }
  .recent-changes-sort select {
    padding: 0.42rem 0.6rem;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 6px;
    color: var(--sl-color-text);
    font-size: 0.88rem;
    font-family: inherit;
    cursor: pointer;
  }
  .recent-changes-sort select:focus {
    outline: none;
    border-color: var(--d4-gold, #eac333);
    box-shadow: 0 0 0 2px rgba(234, 195, 51, 0.18);
  }
  .recent-changes-status {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    color: var(--d4-gold, #eac333);
    font-weight: 600;
  }
  [data-theme='light'] .recent-changes-status { color: #8a6a00; }

  .is-compact .recent-changes-link {
    padding: 0.45rem 0.65rem;
    gap: 0.5rem;
  }
  .is-compact .recent-changes-title { font-size: 0.85em; }
  .is-compact .recent-changes-commit { display: none; }
  .is-compact .recent-changes-meta { font-size: 0.72em; }

  @media (max-width: 640px) {
    .recent-changes-link { flex-direction: column; gap: 0.35rem; }
    .recent-changes-meta { flex-direction: row; align-items: center; }
  }
</style>
