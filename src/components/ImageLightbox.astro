---
---

<div class="img-lightbox" data-state="closed" role="dialog" aria-modal="true" aria-label="이미지 확대 보기" hidden>
  <button class="img-lightbox-close" type="button" aria-label="닫기">×</button>
  <div class="img-lightbox-zoominfo" aria-hidden="true">100%</div>
  <div class="img-lightbox-counter" aria-live="polite">1 / 1</div>
  <figure class="img-lightbox-figure">
    <div class="img-lightbox-canvas">
      <img alt="" draggable="false" />
    </div>
    <figcaption></figcaption>
  </figure>
  <nav class="img-lightbox-nav" aria-label="이미지 갤러리 탐색">
    <button class="img-lightbox-navbtn" data-nav="first" type="button" aria-label="처음 이미지" title="처음 (Home)">&laquo;</button>
    <button class="img-lightbox-navbtn" data-nav="prev" type="button" aria-label="이전 이미지" title="이전 (←)">&lsaquo;</button>
    <span class="img-lightbox-navindex">1 / 1</span>
    <button class="img-lightbox-navbtn" data-nav="next" type="button" aria-label="다음 이미지" title="다음 (→)">&rsaquo;</button>
    <button class="img-lightbox-navbtn" data-nav="last" type="button" aria-label="마지막 이미지" title="마지막 (End)">&raquo;</button>
  </nav>
  <div class="img-lightbox-help" aria-hidden="true">휠: 확대/축소 · 드래그: 이동 · 더블클릭: 원래대로 · ← →: 이전/다음 · Esc: 닫기</div>
</div>

<style is:global>
  .img-lightbox {
    position: fixed;
    inset: 0;
    background: rgba(5, 3, 4, 0.92);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    padding: 2rem;
    cursor: zoom-out;
    overflow: hidden;
  }
  .img-lightbox[hidden] { display: none; }
  .img-lightbox-figure {
    margin: 0;
    max-width: min(92vw, 1400px);
    max-height: 86vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    cursor: default;
  }
  .img-lightbox-canvas {
    max-width: 92vw;
    max-height: 80vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    user-select: none;
  }
  .img-lightbox-canvas.is-zoomed { cursor: grab; }
  .img-lightbox-canvas.is-panning { cursor: grabbing; }
  .img-lightbox-canvas img {
    max-width: 92vw;
    max-height: 80vh;
    object-fit: contain;
    border: 2px solid var(--d4-gold, #eac333);
    border-radius: 6px;
    box-shadow: 0 0 40px rgba(150, 7, 17, 0.6);
    transform-origin: center center;
    will-change: transform;
    transition: transform 0.05s linear;
    user-select: none;
    -webkit-user-drag: none;
  }
  .img-lightbox-figure figcaption {
    color: var(--d4-bone, #d8c8a0);
    font-size: 0.95rem;
    text-align: center;
    max-width: 90vw;
    line-height: 1.4;
  }
  .img-lightbox-figure figcaption:empty { display: none; }
  .img-lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    background: transparent;
    border: 1px solid var(--d4-gold, #eac333);
    color: var(--d4-gold, #eac333);
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s ease, background 0.15s ease;
    z-index: 2;
  }
  .img-lightbox-close:hover { transform: rotate(90deg); background: rgba(234, 195, 51, 0.15); }
  .img-lightbox-zoominfo {
    position: absolute;
    top: 1rem;
    left: 1.25rem;
    color: var(--d4-gold, #eac333);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    background: rgba(0, 0, 0, 0.45);
    padding: 0.3rem 0.7rem;
    border: 1px solid rgba(234, 195, 51, 0.4);
    border-radius: 4px;
    z-index: 2;
    pointer-events: none;
  }
  .img-lightbox-help {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(216, 200, 160, 0.7);
    font-size: 0.78rem;
    text-align: center;
    background: rgba(0, 0, 0, 0.45);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    pointer-events: none;
  }
  .img-lightbox-counter {
    position: absolute;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--d4-gold, #eac333);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    background: rgba(0, 0, 0, 0.45);
    padding: 0.3rem 0.85rem;
    border: 1px solid rgba(234, 195, 51, 0.4);
    border-radius: 999px;
    z-index: 2;
    pointer-events: none;
  }
  .img-lightbox-nav {
    position: absolute;
    bottom: 3.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    gap: 0.55rem;
    align-items: center;
    background: linear-gradient(180deg, rgba(15, 10, 8, 0.85), rgba(5, 3, 4, 0.92));
    padding: 0.5rem 0.85rem;
    border: 1px solid rgba(234, 195, 51, 0.45);
    border-radius: 999px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(234, 195, 51, 0.12);
    z-index: 3;
  }
  .img-lightbox-navbtn {
    flex: 0 0 auto;
    background: transparent;
    border: 1px solid var(--d4-gold, #eac333);
    color: var(--d4-gold, #eac333);
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border-radius: 50%;
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease, opacity 0.15s ease, box-shadow 0.15s ease;
    font-family: inherit;
    font-variant-numeric: tabular-nums;
    box-sizing: border-box;
    vertical-align: middle;
  }
  .img-lightbox-navbtn:hover:not(:disabled),
  .img-lightbox-navbtn:focus-visible {
    background: rgba(234, 195, 51, 0.18);
    outline: none;
    box-shadow: 0 0 0 1px var(--d4-gold, #eac333), 0 0 14px rgba(234, 195, 51, 0.35);
  }
  .img-lightbox-navbtn:active:not(:disabled) {
    background: rgba(234, 195, 51, 0.28);
  }
  .img-lightbox-navbtn:disabled {
    opacity: 0.32;
    cursor: not-allowed;
    border-color: rgba(234, 195, 51, 0.4);
  }
  .img-lightbox-navindex {
    color: var(--d4-bone, #d8c8a0);
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0 0.5rem;
    min-width: 4.5rem;
    height: 2.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    user-select: none;
    vertical-align: middle;
    box-sizing: border-box;
  }
  @media (max-width: 640px) {
    .img-lightbox-nav {
      bottom: 3rem;
      gap: 0.4rem;
      padding: 0.4rem 0.6rem;
    }
    .img-lightbox-navbtn {
      width: 2rem;
      height: 2rem;
      font-size: 1rem;
    }
    .img-lightbox-navindex {
      font-size: 0.85rem;
      min-width: 3.4rem;
      height: 2rem;
      padding: 0 0.3rem;
    }
    .img-lightbox-help { font-size: 0.7rem; bottom: 0.5rem; }
    .img-lightbox-counter { font-size: 0.75rem; padding: 0.2rem 0.6rem; }
  }
</style>

<script is:inline>
  (() => {
    const lb = document.querySelector('.img-lightbox');
    if (!lb) return;
    const img = lb.querySelector('img');
    const cap = lb.querySelector('figcaption');
    const closeBtn = lb.querySelector('.img-lightbox-close');
    const canvas = lb.querySelector('.img-lightbox-canvas');
    const zoomInfo = lb.querySelector('.img-lightbox-zoominfo');
    const counter = lb.querySelector('.img-lightbox-counter');
    const navIndex = lb.querySelector('.img-lightbox-navindex');
    const navFirst = lb.querySelector('[data-nav="first"]');
    const navPrev = lb.querySelector('[data-nav="prev"]');
    const navNext = lb.querySelector('[data-nav="next"]');
    const navLast = lb.querySelector('[data-nav="last"]');

    let scale = 1;
    let tx = 0, ty = 0;
    const MIN_SCALE = 1;
    const MAX_SCALE = 6;
    let isPanning = false;
    let panStart = null;

    let gallery = [];      // current page's img-thumb-btn list
    let currentIdx = -1;

    const applyTransform = () => {
      img.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
      zoomInfo.textContent = `${Math.round(scale * 100)}%`;
      canvas.classList.toggle('is-zoomed', scale > MIN_SCALE);
    };
    const resetTransform = () => {
      scale = 1; tx = 0; ty = 0;
      applyTransform();
    };

    const refreshGallery = () => {
      gallery = Array.from(document.querySelectorAll('.img-thumb-btn'));
    };
    const updateNav = () => {
      const total = gallery.length;
      const label = total > 0 ? `${currentIdx + 1} / ${total}` : '1 / 1';
      navIndex.textContent = label;
      counter.textContent = label;
      const disabled = total <= 1;
      navFirst.disabled = disabled || currentIdx <= 0;
      navPrev.disabled = disabled || currentIdx <= 0;
      navNext.disabled = disabled || currentIdx >= total - 1;
      navLast.disabled = disabled || currentIdx >= total - 1;
    };
    const loadIdx = (idx) => {
      if (idx < 0 || idx >= gallery.length) return;
      const btn = gallery[idx];
      currentIdx = idx;
      img.src = btn.dataset.imgSrc || '';
      img.alt = btn.dataset.imgAlt || '';
      cap.textContent = btn.dataset.imgCaption || '';
      resetTransform();
      updateNav();
    };

    const open = (triggerBtn) => {
      refreshGallery();
      currentIdx = gallery.indexOf(triggerBtn);
      if (currentIdx < 0) {
        // standalone open (no gallery match) — single-image mode
        gallery = [triggerBtn];
        currentIdx = 0;
      }
      loadIdx(currentIdx);
      lb.hidden = false;
      lb.dataset.state = 'open';
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lb.hidden = true;
      lb.dataset.state = 'closed';
      img.src = '';
      resetTransform();
      gallery = [];
      currentIdx = -1;
      document.body.style.overflow = '';
    };
    const goFirst = () => { if (gallery.length > 0) loadIdx(0); };
    const goPrev = () => { if (currentIdx > 0) loadIdx(currentIdx - 1); };
    const goNext = () => { if (currentIdx < gallery.length - 1) loadIdx(currentIdx + 1); };
    const goLast = () => { if (gallery.length > 0) loadIdx(gallery.length - 1); };

    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.img-thumb-btn');
      if (btn) {
        e.preventDefault();
        open(btn);
      }
    });

    lb.addEventListener('click', (e) => {
      if (e.target.closest('.img-lightbox-close')) { close(); return; }
      if (e.target.closest('[data-nav="first"]')) { goFirst(); return; }
      if (e.target.closest('[data-nav="prev"]')) { goPrev(); return; }
      if (e.target.closest('[data-nav="next"]')) { goNext(); return; }
      if (e.target.closest('[data-nav="last"]')) { goLast(); return; }
      if (e.target === lb) close();
    });
    document.addEventListener('keydown', (e) => {
      if (lb.dataset.state !== 'open') return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') { e.preventDefault(); goPrev(); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); goNext(); }
      else if (e.key === 'Home') { e.preventDefault(); goFirst(); }
      else if (e.key === 'End') { e.preventDefault(); goLast(); }
      else if (e.key === '+' || e.key === '=') { scale = Math.min(MAX_SCALE, scale * 1.2); applyTransform(); }
      else if (e.key === '-' || e.key === '_') { scale = Math.max(MIN_SCALE, scale / 1.2); if (scale === MIN_SCALE) { tx = 0; ty = 0; } applyTransform(); }
      else if (e.key === '0') resetTransform();
    });

    canvas.addEventListener('wheel', (e) => {
      e.preventDefault();
      const rect = img.getBoundingClientRect();
      const cx = e.clientX - rect.left - rect.width / 2;
      const cy = e.clientY - rect.top - rect.height / 2;
      const factor = e.deltaY < 0 ? 1.15 : 1 / 1.15;
      const newScale = Math.min(MAX_SCALE, Math.max(MIN_SCALE, scale * factor));
      const ratio = newScale / scale;
      tx = (tx - cx) * ratio + cx;
      ty = (ty - cy) * ratio + cy;
      scale = newScale;
      if (scale === MIN_SCALE) { tx = 0; ty = 0; }
      applyTransform();
    }, { passive: false });

    canvas.addEventListener('dblclick', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (scale > MIN_SCALE) resetTransform();
      else {
        const rect = img.getBoundingClientRect();
        const cx = e.clientX - rect.left - rect.width / 2;
        const cy = e.clientY - rect.top - rect.height / 2;
        const newScale = 2;
        tx = -cx * newScale;
        ty = -cy * newScale;
        scale = newScale;
        applyTransform();
      }
    });

    canvas.addEventListener('pointerdown', (e) => {
      if (scale <= MIN_SCALE) return;
      isPanning = true;
      panStart = { x: e.clientX - tx, y: e.clientY - ty };
      canvas.setPointerCapture(e.pointerId);
      canvas.classList.add('is-panning');
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!isPanning) return;
      tx = e.clientX - panStart.x;
      ty = e.clientY - panStart.y;
      applyTransform();
    });
    const endPan = (e) => {
      if (!isPanning) return;
      isPanning = false;
      panStart = null;
      try { canvas.releasePointerCapture(e.pointerId); } catch {}
      canvas.classList.remove('is-panning');
    };
    canvas.addEventListener('pointerup', endPan);
    canvas.addEventListener('pointercancel', endPan);

    canvas.addEventListener('click', (e) => e.stopPropagation());
  })();
</script>
