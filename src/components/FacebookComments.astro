---
// FacebookComments.astro
// Renders the Facebook Comments Plugin (Graph API v19.0+) per page.
// data-href is set to the canonical page URL so each page has its own thread.

const FB_APP_ID = import.meta.env.PUBLIC_FB_APP_ID || 'PLACEHOLDER_APP_ID';
const isPlaceholder = FB_APP_ID === 'PLACEHOLDER_APP_ID';

interface Props {
  url?: string;
}
const { url } = Astro.props as Props;

const PROD_BASE = 'https://nimto.github.io/d4cute';
const pathname = Astro.url.pathname.replace(/^\/d4cute/, '');
const canonicalUrl = url || `${PROD_BASE}${pathname}`;
---

<div class="fb-comments-wrapper">
  <h2>💬 댓글</h2>

  {isPlaceholder ? (
    <div class="fb-comments-placeholder">
      <strong>Facebook 댓글 위젯 비활성화 상태</strong>
      <p>
        Facebook App ID가 <code>PLACEHOLDER_APP_ID</code>로 설정되어 있습니다.
        실제 댓글 기능을 활성화하려면 <code>.env</code> 파일에
        <code>PUBLIC_FB_APP_ID</code>를 등록한 뒤 재배포하세요.
        자세한 절차는 README의 "Facebook App ID 교체" 섹션을 참고합니다.
      </p>
    </div>
  ) : (
    <>
      <div id="fb-root"></div>
      <div
        class="fb-comments"
        data-href={canonicalUrl}
        data-numposts="10"
        data-width="100%"
        data-colorscheme="dark"
      ></div>
    </>
  )}
</div>

{!isPlaceholder && (
  <script
    is:inline
    async
    defer
    crossorigin="anonymous"
    src={`https://connect.facebook.net/ko_KR/sdk.js#xfbml=1&version=v19.0&appId=${FB_APP_ID}`}
  ></script>
)}
