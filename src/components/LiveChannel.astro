---
interface Props {
  channelId: string;
  channelHandle: string;
  channelName: string;
  fallbackVideoId?: string;
  description?: string;
  discord?: string;
}
const {
  channelId,
  channelHandle,
  channelName,
  description,
  discord,
} = Astro.props as Props;

const encodedHandle = encodeURIComponent(channelHandle);
const liveUrl = `https://www.youtube.com/@${encodedHandle}/live`;
const channelUrl = `https://www.youtube.com/@${encodedHandle}`;
---

<div
  class="channel-promo live-channel"
  data-channel-id={channelId}
  data-live-url={liveUrl}
  data-channel-url={channelUrl}
  data-channel-name={channelName}
>
  <div class="channel-embed" data-role="embed-slot">
    <div class="lc-placeholder lc-placeholder-checking" data-role="placeholder">
      <span class="lc-placeholder-icon" aria-hidden="true">⏳</span>
      <p class="lc-placeholder-title" data-role="placeholder-title">라이브 상태 확인 중...</p>
      <p class="lc-placeholder-sub" data-role="placeholder-sub">잠시만 기다려 주세요.</p>
      <a
        class="lc-placeholder-cta"
        data-role="placeholder-cta"
        href={channelUrl}
        target="_blank"
        rel="noopener noreferrer"
        hidden
      >🎬 채널 홈 방문</a>
    </div>
    <div class="lc-status-overlay">
      <span class="lc-pill lc-pill-offline" data-role="offline-pill" hidden>⚫ 현재 방송 중 아님</span>
      <span class="lc-pill lc-pill-live" data-role="live-pill" hidden>
        <span class="lc-dot" aria-hidden="true"></span>
        🔴 LIVE 방송 중
      </span>
      <span class="lc-pill lc-pill-checking" data-role="checking-pill">⏳ 라이브 확인 중...</span>
    </div>
  </div>
  <div class="channel-meta">
    <div class="channel-badge" data-role="header-badge">📺 추천 채널</div>
    <h3 class="channel-name">
      <a data-role="title-link" href={channelUrl} target="_blank" rel="noopener noreferrer">{channelName}</a>
    </h3>
    {description && <p class="channel-desc">{description}</p>}
    <p class="channel-status-line" data-role="status-line">
      현재 상태 확인 중 — 방송 중이면 라이브 영상, 아니면 채널 홈으로 이동합니다.
    </p>
    <div class="channel-actions">
      <a
        class="channel-btn primary"
        data-role="primary-link"
        href={channelUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        🎬 채널 홈 방문
      </a>
      <a
        class="channel-btn"
        data-role="latest-link"
        href={channelUrl}
        target="_blank"
        rel="noopener noreferrer"
        hidden
      >
        📼 최신 녹화 영상
      </a>
      <a
        class="channel-btn"
        href={channelUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        🎬 채널 홈
      </a>
      {discord && (
        <a class="channel-btn" href={discord} target="_blank" rel="noopener noreferrer">
          💬 Discord 참여
        </a>
      )}
    </div>
  </div>

  <section class="lc-info-panel" data-role="info-panel" aria-live="polite">
    <header class="lc-info-channel">
      <img
        class="lc-info-avatar"
        data-role="channel-avatar"
        alt=""
        width="44"
        height="44"
        loading="lazy"
        referrerpolicy="no-referrer"
        hidden
      />
      <div class="lc-info-channel-meta">
        <a
          class="lc-info-channel-title"
          data-role="channel-title-link"
          href={channelUrl}
          target="_blank"
          rel="noopener noreferrer"
        >{channelName}</a>
        <!-- 구독자 수 — 임시 숨김. 향후 채널 성장 후 hidden 제거하면 노출. -->
        <span class="lc-info-channel-subs" data-role="channel-subs" hidden></span>
      </div>
      <span class="lc-info-mode-tag" data-role="mode-tag">⏳ 확인 중</span>
    </header>

    <p class="lc-info-title" data-role="video-title"></p>

    <ul class="lc-info-stats" data-role="stats">
      <li class="lc-info-stat" data-role="stat-viewers" hidden>
        <span class="lc-info-stat-label">👀 동시 시청자</span>
        <span class="lc-info-stat-value" data-role="viewers-value">-</span>
      </li>
      <li class="lc-info-stat" data-role="stat-likes" hidden>
        <span class="lc-info-stat-label">👍 좋아요</span>
        <span class="lc-info-stat-value" data-role="likes-value">-</span>
      </li>
      <li class="lc-info-stat" data-role="stat-elapsed" hidden>
        <span class="lc-info-stat-label">⏱️ 방송 진행 시간</span>
        <span class="lc-info-stat-value" data-role="elapsed-value">-</span>
      </li>
      <li class="lc-info-stat" data-role="stat-started" hidden>
        <span class="lc-info-stat-label">📅 방송 시작</span>
        <span class="lc-info-stat-value" data-role="started-value">-</span>
      </li>
      <li class="lc-info-stat" data-role="stat-published" hidden>
        <span class="lc-info-stat-label">📅 업로드</span>
        <span class="lc-info-stat-value" data-role="published-value">-</span>
      </li>
      <li class="lc-info-stat" data-role="stat-length" hidden>
        <span class="lc-info-stat-label">⏱️ 영상 길이</span>
        <span class="lc-info-stat-value" data-role="length-value">-</span>
      </li>
    </ul>

    <p class="lc-info-desc" data-role="video-desc" hidden></p>

    <footer class="lc-info-foot">
      <span class="lc-info-updated">
        마지막 갱신: <time data-role="updated-at">-</time>
        · 자동 갱신 60초
      </span>
      <button type="button" class="lc-info-refresh" data-role="refresh-btn">🔄 새로고침</button>
    </footer>
  </section>
</div>

<style>
  .live-channel {
    position: relative;
    --lc-z-overlay: var(--sl-z-index-toc, 2);
    --lc-live-strong: var(--d4-blood-bright, #c01020);
    --lc-live-deep: var(--d4-blood, #960711);
    --lc-live-edge: var(--sl-color-accent-high, #ff4d5a);
    --lc-on-live: var(--sl-color-white, #f5ecd6);
    --lc-pill-bg-dark: rgba(20, 20, 24, 0.75);
    --lc-pill-bg-checking: rgba(20, 20, 24, 0.6);
    --lc-pill-border-soft: rgba(255, 255, 255, 0.18);
    --lc-pill-shadow: rgba(0, 0, 0, 0.35);
    --lc-live-edge-soft: rgba(255, 64, 64, 0.35);
    --lc-live-edge-strong: rgba(255, 64, 64, 0.6);
    --lc-live-halo-soft: rgba(200, 15, 30, 0.45);
    --lc-live-halo: rgba(200, 15, 30, 0.55);
    --lc-live-halo-strong: rgba(200, 15, 30, 0.85);
    --lc-live-embed-halo: rgba(200, 15, 30, 0.6);
    --lc-dot-halo: rgba(255, 133, 133, 0.9);
    --lc-status-live-fg: var(--sl-color-accent-high, #ff4d5a);
    --lc-status-light-fg: var(--sl-color-gray-5, #2a2520);
    --lc-status-light-live-fg: var(--d4-blood, #960711);
    --lc-light-pill-bg: rgba(255, 255, 255, 0.85);
    --lc-light-pill-border: var(--d4-gold-dim, #9c7f1f);
    --lc-gold-soft: rgba(234, 195, 51, 0.55);
  }
  .live-channel .channel-embed {
    position: relative;
  }
  .lc-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 1rem 1.2rem;
    text-align: center;
    background: linear-gradient(135deg, var(--lc-pill-shadow), var(--lc-pill-bg-dark));
    color: var(--d4-bone);
    border-radius: inherit;
  }
  .lc-placeholder-icon {
    font-size: 2.4rem;
    line-height: 1;
    filter: drop-shadow(0 2px 6px var(--lc-pill-shadow));
  }
  .lc-placeholder-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--d4-gold);
    letter-spacing: 0.02em;
  }
  .lc-placeholder-sub {
    margin: 0;
    font-size: 0.85rem;
    color: var(--d4-bone);
    opacity: 0.85;
    line-height: 1.5;
    max-width: 32ch;
  }
  .lc-placeholder-cta {
    margin-top: 0.45rem;
    display: inline-block;
    padding: 0.5rem 1.05rem;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--d4-bone);
    background: var(--lc-live-deep);
    border: 1px solid var(--lc-live-edge);
    border-radius: 6px;
    box-shadow: 0 2px 8px var(--lc-pill-shadow);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .lc-placeholder-cta:hover {
    background: var(--lc-live-strong);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .lc-placeholder-cta[hidden] { display: none; }
  .lc-status-overlay {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    z-index: var(--lc-z-overlay);
    pointer-events: none;
  }
  .lc-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.6rem;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;
    border-radius: 999px;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: 0 1px 4px var(--lc-pill-shadow);
    pointer-events: auto;
    letter-spacing: 0.02em;
  }
  .lc-pill-offline {
    background: var(--lc-pill-bg-dark);
    color: var(--d4-bone);
    border: 1px solid var(--lc-gold-soft);
  }
  .lc-pill-live {
    background: linear-gradient(135deg, var(--lc-live-strong), var(--lc-live-deep));
    color: var(--lc-on-live);
    border: 1px solid var(--lc-live-edge);
    box-shadow: 0 0 0 1px var(--lc-live-edge-soft), 0 0 14px var(--lc-live-halo);
    animation: lc-live-glow 2s ease-in-out infinite;
  }
  .lc-pill-checking {
    background: var(--lc-pill-bg-checking);
    color: var(--sl-color-gray-2);
    border: 1px solid var(--lc-pill-border-soft);
    font-weight: 500;
  }
  .lc-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 6px currentColor, 0 0 12px var(--lc-dot-halo);
    animation: lc-dot-blink 1.1s ease-in-out infinite;
  }
  .live-channel.is-live .channel-embed {
    box-shadow: 0 0 0 2px var(--lc-live-strong), 0 0 18px var(--lc-live-embed-halo);
  }
  .live-channel.is-live .channel-badge {
    background: linear-gradient(135deg, var(--lc-live-strong), var(--lc-live-deep));
    color: var(--lc-on-live);
    border-color: var(--lc-live-edge);
    animation: lc-live-glow 2.4s ease-in-out infinite;
  }
  @keyframes lc-live-glow {
    0%, 100% { box-shadow: 0 0 0 1px var(--lc-live-edge-soft), 0 0 14px var(--lc-live-halo-soft); }
    50% { box-shadow: 0 0 0 2px var(--lc-live-edge-strong), 0 0 22px var(--lc-live-halo-strong); }
  }
  @keyframes lc-dot-blink {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.7); }
  }
  .channel-status-line {
    margin: 0;
    font-size: 0.85rem;
    color: var(--d4-bone);
    opacity: 0.85;
  }
  .live-channel.is-live .channel-status-line {
    color: var(--lc-status-live-fg);
    font-weight: 600;
    opacity: 1;
  }

  .live-channel {
    --lc-info-bg: rgba(0, 0, 0, 0.32);
    --lc-info-border: rgba(234, 195, 51, 0.22);
    --lc-info-stat-bg: rgba(234, 195, 51, 0.08);
    --lc-info-stat-border: rgba(234, 195, 51, 0.18);
    --lc-info-foot-fg: var(--sl-color-gray-3);
    --lc-info-refresh-hover: rgba(234, 195, 51, 0.18);
    --lc-info-fg: var(--d4-bone);
    --lc-info-accent: var(--d4-gold);
    --lc-info-light-bg: rgba(255, 255, 255, 0.55);
    --lc-info-light-stat-bg: rgba(255, 255, 255, 0.7);
    --lc-info-light-border: var(--lc-light-pill-border);
    --lc-info-light-fg: var(--lc-status-light-fg);
  }

  .lc-info-panel {
    grid-column: 1 / -1;
    margin-top: 0.6rem;
    padding: 0.85rem 1rem;
    background: var(--lc-info-bg);
    border: 1px solid var(--lc-info-border);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    color: var(--lc-info-fg);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .lc-info-channel {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .lc-info-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--lc-info-border);
    background: var(--lc-info-stat-bg);
    flex: 0 0 auto;
  }
  .lc-info-channel-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .lc-info-channel-title {
    color: var(--lc-info-accent);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    border-bottom: 1px dotted currentColor;
  }
  .lc-info-channel-title:hover { text-decoration: none; }
  .lc-info-channel-subs {
    font-size: 0.82rem;
    color: var(--lc-info-fg);
    opacity: 0.85;
  }
  .lc-info-mode-tag {
    margin-left: auto;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: var(--lc-pill-bg-dark);
    color: var(--lc-info-fg);
    border: 1px solid var(--lc-pill-border-soft);
    flex: 0 0 auto;
  }
  .live-channel.is-live .lc-info-mode-tag {
    background: linear-gradient(135deg, var(--lc-live-strong), var(--lc-live-deep));
    color: var(--lc-on-live);
    border-color: var(--lc-live-edge);
  }

  .lc-info-title {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--lc-info-accent);
    line-height: 1.4;
  }
  .lc-info-title:empty { display: none; }

  /* Override author display:flex so [hidden] actually hides stat cards. */
  .lc-info-stat[hidden],
  .lc-info-avatar[hidden],
  .lc-info-desc[hidden],
  .lc-info-panel [hidden] {
    display: none;
  }

  .lc-info-stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.4rem;
  }
  .lc-info-stat {
    background: var(--lc-info-stat-bg);
    border: 1px solid var(--lc-info-stat-border);
    border-radius: 6px;
    padding: 0.4rem 0.55rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .lc-info-stat-label {
    font-size: 0.74rem;
    color: var(--lc-info-fg);
    opacity: 0.85;
    letter-spacing: 0.02em;
  }
  .lc-info-stat-value {
    font-size: 0.96rem;
    font-weight: 700;
    color: var(--lc-info-accent);
    font-variant-numeric: tabular-nums;
  }

  .lc-info-desc {
    margin: 0;
    font-size: 0.86rem;
    color: var(--lc-info-fg);
    opacity: 0.92;
    line-height: 1.55;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .lc-info-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.78rem;
    color: var(--lc-info-foot-fg);
  }
  .lc-info-updated time { font-variant-numeric: tabular-nums; }
  .lc-info-refresh {
    margin-left: auto;
    padding: 0.3rem 0.65rem;
    background: transparent;
    border: 1px solid var(--lc-info-border);
    color: var(--lc-info-accent);
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 600;
    font-family: inherit;
  }
  .lc-info-refresh:hover { background: var(--lc-info-refresh-hover); }
  .lc-info-refresh:disabled { opacity: 0.5; cursor: progress; }

  [data-theme='light'] .live-channel {
    --lc-pill-bg-dark: var(--lc-light-pill-bg);
    --lc-pill-bg-checking: var(--lc-light-pill-bg);
    --lc-gold-soft: var(--lc-light-pill-border);
    --lc-pill-border-soft: var(--lc-light-pill-border);
  }
  [data-theme='light'] .lc-pill-offline,
  [data-theme='light'] .lc-pill-checking {
    color: var(--lc-status-light-fg);
    font-weight: 600;
  }
  [data-theme='light'] .channel-status-line { color: var(--lc-status-light-fg); opacity: 1; }
  [data-theme='light'] .live-channel.is-live .channel-status-line { color: var(--lc-status-light-live-fg); }
</style>

<script>
  interface VideoDetail {
    videoId: string;
    title?: string | null;
    author?: string | null;
    channelId?: string | null;
    viewCount?: number | null;
    likeCount?: number | null;
    lengthSeconds?: number | null;
    isLive?: boolean;
    shortDescription?: string | null;
    subscriberLabel?: string | null;
    channelAvatarUrl?: string | null;
    startTimestamp?: string | null;
    endTimestamp?: string | null;
    publishDate?: string | null;
    publishedTimeText?: string | null;
    thumbnailUrl?: string | null;
    watchUrl?: string | null;
    error?: string | null;
  }

  interface ChannelInfo {
    id?: string;
    title?: string;
    avatarUrl?: string;
    subscriberLabel?: string | null;
    handle?: string;
    url?: string;
  }

  type LiveResult =
    | { state: 'live'; videoId: string; title?: string; detail?: VideoDetail | null; channel?: ChannelInfo | null }
    | { state: 'offline'; latestVideoId?: string; latestTitle?: string; detail?: VideoDetail | null; channel?: ChannelInfo | null }
    | { state: 'unknown' };

  interface LiveStatus {
    schema: number;
    generatedAt: string;
    channelId: string;
    handle: string;
    state: 'live' | 'offline' | 'unknown';
    channel?: ChannelInfo | null;
    live: { videoId: string; title?: string | null; detail?: VideoDetail | null } | null;
    latest: { videoId: string; title?: string | null; publishedAt?: string | null; detail?: VideoDetail | null } | null;
    error?: string | null;
  }

  const STATUS_FEEDS = [
    'https://raw.githubusercontent.com/nimto/d4cute/live-status/live-status.json',
    'https://cdn.jsdelivr.net/gh/nimto/d4cute@live-status/live-status.json',
  ];

  const PROXIES = [
    'https://corsproxy.io/?url=',
    'https://api.codetabs.com/v1/proxy?quest=',
    'https://api.allorigins.win/raw?url=',
  ];

  async function fetchLiveStatus(): Promise<LiveStatus | null> {
    const tasks = STATUS_FEEDS.map(async (url) => {
      const res = await fetch(`${url}?_=${Date.now()}`, { cache: 'no-store' });
      if (!res.ok) throw new Error(`status ${res.status}`);
      return (await res.json()) as LiveStatus;
    });
    try {
      return await Promise.any(tasks);
    } catch {
      return null;
    }
  }

  async function fetchViaProxy(target: string): Promise<string | null> {
    const attempts = PROXIES.map(async (proxy) => {
      const url = proxy + encodeURIComponent(target);
      const res = await fetch(url, { cache: 'no-store' });
      if (!res.ok) throw new Error(`status ${res.status}`);
      const text = await res.text();
      if (!text || text.length < 1000) throw new Error('too short');
      return text;
    });
    try {
      return await Promise.any(attempts);
    } catch {
      return null;
    }
  }

  function extractVideoIdFromLiveHtml(html: string): string | null {
    const m =
      html.match(/"videoDetails"\s*:\s*\{\s*"videoId"\s*:\s*"([A-Za-z0-9_-]{11})"/) ||
      html.match(/<link rel="canonical"[^>]*href="https?:\/\/www\.youtube\.com\/watch\?v=([A-Za-z0-9_-]{11})"/) ||
      html.match(/"liveBroadcastDetails"[^}]*"videoId":"([A-Za-z0-9_-]{11})"/) ||
      html.match(/"isLiveBroadcast":\s*true[\s\S]{0,2000}?"videoId":"([A-Za-z0-9_-]{11})"/) ||
      html.match(/<meta itemprop="videoId" content="([A-Za-z0-9_-]{11})"/) ||
      html.match(/"isLive"\s*:\s*true[\s\S]{0,4000}?"videoId":"([A-Za-z0-9_-]{11})"/);
    return m ? m[1] : null;
  }

  function isHtmlLive(html: string): boolean {
    if (/"isLiveBroadcast"\s*:\s*true/.test(html)) return true;
    if (/"isLive"\s*:\s*true/.test(html)) return true;
    if (/"isLiveContent"\s*:\s*true/.test(html)) return true;
    if (/"isLiveNow"\s*:\s*true/.test(html)) return true;
    if (/"liveBroadcastDetails"\s*:\s*\{[^}]*"isLiveNow"\s*:\s*true/.test(html)) return true;
    return false;
  }

  function extractLatestVideoIdFromRss(xml: string): { id?: string; title?: string } {
    const idMatch = xml.match(/<yt:videoId>([A-Za-z0-9_-]{11})<\/yt:videoId>/);
    const titleMatch = xml.match(/<entry>[\s\S]*?<title>([^<]+)<\/title>/);
    return { id: idMatch?.[1], title: titleMatch?.[1] };
  }

  async function checkChannel(channelId: string): Promise<LiveResult> {
    // 1) Server-side built static JSON (cron, no CORS issues) — most reliable.
    const status = await fetchLiveStatus();
    if (status && (!status.channelId || status.channelId === channelId)) {
      if (status.state === 'live' && status.live?.videoId) {
        return {
          state: 'live',
          videoId: status.live.videoId,
          title: status.live.title || undefined,
          detail: status.live.detail || null,
          channel: status.channel || null,
        };
      }
      if (status.state === 'offline') {
        return {
          state: 'offline',
          latestVideoId: status.latest?.videoId,
          latestTitle: status.latest?.title || undefined,
          detail: status.latest?.detail || null,
          channel: status.channel || null,
        };
      }
    }

    // 2) Client-side fallback via CORS proxies (best-effort).
    const liveUrl = `https://www.youtube.com/channel/${channelId}/live`;
    const liveHtml = await fetchViaProxy(liveUrl);
    if (liveHtml && isHtmlLive(liveHtml)) {
      const videoId = extractVideoIdFromLiveHtml(liveHtml);
      if (videoId) return { state: 'live', videoId };
    }

    const rssUrl = `https://www.youtube.com/feeds/videos.xml?channel_id=${channelId}`;
    const rssXml = await fetchViaProxy(rssUrl);
    if (rssXml) {
      const latest = extractLatestVideoIdFromRss(rssXml);
      if (latest.id) {
        return { state: 'offline', latestVideoId: latest.id, latestTitle: latest.title };
      }
    }

    if (liveHtml) return { state: 'offline' };
    return { state: 'unknown' };
  }

  function fmtNumber(n: number | null | undefined): string {
    if (n == null || Number.isNaN(n)) return '-';
    try {
      return new Intl.NumberFormat('ko-KR').format(n);
    } catch {
      return String(n);
    }
  }
  function fmtDate(iso: string | null | undefined): string {
    if (!iso) return '-';
    try {
      const d = new Date(iso);
      return d.toLocaleString('ko-KR', {
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit',
      });
    } catch {
      return iso;
    }
  }
  function fmtTime(iso: string | null | undefined): string {
    if (!iso) return '-';
    try {
      const d = new Date(iso);
      return d.toLocaleTimeString('ko-KR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    } catch {
      return iso;
    }
  }
  function fmtElapsed(ms: number): string {
    const total = Math.max(0, Math.floor(ms / 1000));
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const s = total % 60;
    const pad = (n: number) => String(n).padStart(2, '0');
    return h > 0 ? `${h}시간 ${pad(m)}분 ${pad(s)}초` : `${pad(m)}분 ${pad(s)}초`;
  }
  function fmtDuration(seconds: number | null | undefined): string {
    if (!seconds || seconds <= 0) return '-';
    return fmtElapsed(seconds * 1000);
  }

  function setVisible(el: Element | null, value: string | null | undefined, valueSelector?: string) {
    if (!el) return;
    const filled = value != null && value !== '' && value !== '-';
    if (filled) el.removeAttribute('hidden');
    else el.setAttribute('hidden', '');
    if (valueSelector) {
      const target = el.querySelector(valueSelector);
      if (target) target.textContent = filled ? String(value) : '-';
    }
  }

  function applyInfoPanel(el: HTMLElement, kind: 'live' | 'offline' | 'unknown', detail: VideoDetail | null | undefined, channel: ChannelInfo | null | undefined) {
    const panel = el.querySelector<HTMLElement>('[data-role="info-panel"]');
    if (!panel) return;

    // Channel header.
    const avatar = panel.querySelector<HTMLImageElement>('[data-role="channel-avatar"]');
    const avatarUrl = channel?.avatarUrl || detail?.channelAvatarUrl;
    if (avatar) {
      if (avatarUrl) {
        avatar.src = avatarUrl;
        avatar.removeAttribute('hidden');
      } else {
        avatar.setAttribute('hidden', '');
        avatar.removeAttribute('src');
      }
    }
    const titleLink = panel.querySelector<HTMLAnchorElement>('[data-role="channel-title-link"]');
    if (titleLink && (channel?.title || detail?.author)) {
      titleLink.textContent = channel?.title || detail?.author || '';
      if (channel?.url) titleLink.href = channel.url;
    }
    const subs = panel.querySelector<HTMLElement>('[data-role="channel-subs"]');
    if (subs) {
      const sub = channel?.subscriberLabel || detail?.subscriberLabel || '';
      subs.textContent = sub;
      // Auto-reveal once subscriber count crosses threshold. Lower the number
      // here (or remove the guard entirely) when the channel grows.
      const SUBS_REVEAL_THRESHOLD = 1000;
      const numMatch = sub.replace(/,/g, '').match(/(\d+)/);
      if (numMatch && Number(numMatch[1]) >= SUBS_REVEAL_THRESHOLD) {
        subs.removeAttribute('hidden');
      } else {
        subs.setAttribute('hidden', '');
      }
    }
    const modeTag = panel.querySelector<HTMLElement>('[data-role="mode-tag"]');
    if (modeTag) {
      if (kind === 'live') modeTag.textContent = '🔴 LIVE';
      else if (kind === 'offline') modeTag.textContent = '📼 녹화 영상';
      else modeTag.textContent = '⏳ 확인 중';
    }

    // Video title.
    const videoTitle = panel.querySelector<HTMLElement>('[data-role="video-title"]');
    if (videoTitle) videoTitle.textContent = detail?.title || '';

    // Stats.
    setVisible(panel.querySelector('[data-role="stat-viewers"]'), detail?.viewCount != null ? fmtNumber(detail.viewCount) + (kind === 'live' ? '명' : '회') : null, '[data-role="viewers-value"]');
    setVisible(panel.querySelector('[data-role="stat-likes"]'), detail?.likeCount != null ? fmtNumber(detail.likeCount) + '개' : null, '[data-role="likes-value"]');

    // Live elapsed / started — only when live.
    const elapsedEl = panel.querySelector<HTMLElement>('[data-role="stat-elapsed"]');
    const startedEl = panel.querySelector<HTMLElement>('[data-role="stat-started"]');
    if (kind === 'live' && detail?.startTimestamp) {
      const startMs = new Date(detail.startTimestamp).getTime();
      el.dataset.lcLiveStartMs = String(startMs);
      setVisible(elapsedEl, fmtElapsed(Date.now() - startMs), '[data-role="elapsed-value"]');
      setVisible(startedEl, fmtTime(detail.startTimestamp), '[data-role="started-value"]');
    } else {
      delete el.dataset.lcLiveStartMs;
      if (elapsedEl) { elapsedEl.setAttribute('hidden', ''); }
      if (startedEl) { startedEl.setAttribute('hidden', ''); }
    }

    // Published — only when offline.
    const publishedEl = panel.querySelector<HTMLElement>('[data-role="stat-published"]');
    const lengthEl = panel.querySelector<HTMLElement>('[data-role="stat-length"]');
    if (kind === 'offline') {
      setVisible(publishedEl, fmtDate(detail?.publishDate), '[data-role="published-value"]');
      setVisible(lengthEl, fmtDuration(detail?.lengthSeconds), '[data-role="length-value"]');
    } else {
      if (publishedEl) publishedEl.setAttribute('hidden', '');
      if (lengthEl) lengthEl.setAttribute('hidden', '');
    }

    // Description — first ~280 chars.
    const desc = panel.querySelector<HTMLElement>('[data-role="video-desc"]');
    if (desc) {
      const raw = (detail?.shortDescription || '').trim();
      if (raw) {
        desc.textContent = raw.length > 280 ? raw.slice(0, 280) + '…' : raw;
        desc.removeAttribute('hidden');
      } else {
        desc.textContent = '';
        desc.setAttribute('hidden', '');
      }
    }

    // Updated time.
    const updated = panel.querySelector<HTMLElement>('[data-role="updated-at"]');
    if (updated) updated.textContent = new Date().toLocaleTimeString('ko-KR');
  }

  function removeEmbedIframe(el: HTMLElement) {
    const iframe = el.querySelector<HTMLIFrameElement>('.lc-iframe');
    if (iframe) iframe.remove();
  }

  function ensureEmbedIframe(el: HTMLElement, videoId: string, channelName: string, mode: 'live' | 'vod'): HTMLIFrameElement | null {
    const slot = el.querySelector<HTMLElement>('[data-role="embed-slot"]');
    if (!slot) return null;
    let iframe = slot.querySelector<HTMLIFrameElement>('.lc-iframe');
    const params = mode === 'live'
      ? 'autoplay=1&mute=1&rel=0&modestbranding=1&playsinline=1'
      : 'autoplay=0&rel=0&modestbranding=1&playsinline=1';
    const src = `https://www.youtube-nocookie.com/embed/${videoId}?${params}`;
    const title = mode === 'live'
      ? `${channelName} — 🔴 LIVE 방송 중`
      : `${channelName} — 📼 최신 녹화 영상`;
    if (!iframe) {
      iframe = document.createElement('iframe');
      iframe.className = 'lc-iframe';
      iframe.setAttribute('frameborder', '0');
      iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
      iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute('loading', 'lazy');
      slot.insertBefore(iframe, slot.firstChild);
    }
    iframe.title = title;
    if (iframe.src !== src) iframe.src = src;
    return iframe;
  }

  function applyLive(el: HTMLElement, videoId: string, detail?: VideoDetail | null, channel?: ChannelInfo | null) {
    // 라이브 클릭 라우팅은 채널 /live canonical URL 사용.
    // YouTube 자체 redirect 가 항상 "현재 진행 중" 라이브로 보냄 →
    // 사이트의 live-status JSON 이 stale 인 경우에도 정확한 라이브로 이동.
    // videoId 기반 watch URL 은 백업으로만 사용 (특정 영상 직링크).
    const liveCanonicalUrl = el.dataset.liveUrl || `https://www.youtube.com/watch?v=${videoId}`;
    const videoWatchUrl = `https://www.youtube.com/watch?v=${videoId}`;
    const channelName = el.dataset.channelName || '';
    ensureEmbedIframe(el, videoId, channelName, 'live');
    const placeholder = el.querySelector<HTMLElement>('[data-role="placeholder"]');
    if (placeholder) placeholder.setAttribute('hidden', '');
    el.querySelector('[data-role="offline-pill"]')?.setAttribute('hidden', '');
    el.querySelector('[data-role="checking-pill"]')?.setAttribute('hidden', '');
    el.querySelector('[data-role="live-pill"]')?.removeAttribute('hidden');
    const titleLink = el.querySelector<HTMLAnchorElement>('[data-role="title-link"]');
    if (titleLink) titleLink.href = liveCanonicalUrl;
    const primary = el.querySelector<HTMLAnchorElement>('[data-role="primary-link"]');
    if (primary) {
      primary.href = liveCanonicalUrl;
      primary.textContent = '🔴 LIVE 시청 (현재 방송 중)';
    }
    // 보조 버튼: videoId 직링크 (live-status JSON 의 라이브 영상 ID)
    const latest = el.querySelector<HTMLAnchorElement>('[data-role="latest-link"]');
    if (latest) {
      latest.href = videoWatchUrl;
      latest.textContent = '🎥 라이브 영상 직링크';
      latest.removeAttribute('hidden');
    }
    const status = el.querySelector<HTMLElement>('[data-role="status-line"]');
    if (status) status.textContent = `🔴 지금 LIVE 방송 중 — 시청 버튼을 누르면 ${liveCanonicalUrl} 으로 이동합니다.`;
    const badge = el.querySelector<HTMLElement>('[data-role="header-badge"]');
    if (badge) badge.textContent = '🔴 지금 방송 중';
    el.classList.add('is-live');
    applyInfoPanel(el, 'live', detail, channel);
  }

  function applyOffline(el: HTMLElement, latestVideoId?: string, latestTitle?: string, detail?: VideoDetail | null, channel?: ChannelInfo | null) {
    const channelUrl = el.dataset.channelUrl || '#';
    const channelName = el.dataset.channelName || '';
    const watchUrl = latestVideoId ? `https://www.youtube.com/watch?v=${latestVideoId}` : channelUrl;
    const placeholder = el.querySelector<HTMLElement>('[data-role="placeholder"]');
    const isPastLive = !!(detail && detail.isLive);

    if (latestVideoId) {
      ensureEmbedIframe(el, latestVideoId, channelName, 'vod');
      if (placeholder) placeholder.setAttribute('hidden', '');
    } else {
      removeEmbedIframe(el);
      if (placeholder) {
        placeholder.removeAttribute('hidden');
        placeholder.classList.remove('lc-placeholder-checking');
        placeholder.classList.add('lc-placeholder-offline');
      }
      const phIcon = el.querySelector<HTMLElement>('.lc-placeholder-icon');
      if (phIcon) phIcon.textContent = '📺';
      const phTitle = el.querySelector<HTMLElement>('[data-role="placeholder-title"]');
      if (phTitle) phTitle.textContent = '최신 녹화 영상을 찾지 못했습니다';
      const phSub = el.querySelector<HTMLElement>('[data-role="placeholder-sub"]');
      if (phSub) phSub.textContent = '채널 홈에서 다음 방송 일정과 영상을 확인하세요.';
      const phCta = el.querySelector<HTMLAnchorElement>('[data-role="placeholder-cta"]');
      if (phCta) {
        phCta.href = channelUrl;
        phCta.textContent = '🎬 채널 홈 방문';
        phCta.removeAttribute('hidden');
      }
    }

    el.querySelector('[data-role="checking-pill"]')?.setAttribute('hidden', '');
    el.querySelector('[data-role="live-pill"]')?.setAttribute('hidden', '');
    const offlinePill = el.querySelector<HTMLElement>('[data-role="offline-pill"]');
    if (offlinePill) {
      offlinePill.textContent = isPastLive ? '📼 지난 라이브 다시보기' : '📼 최신 녹화 영상';
      offlinePill.removeAttribute('hidden');
    }
    const titleLink = el.querySelector<HTMLAnchorElement>('[data-role="title-link"]');
    if (titleLink) titleLink.href = watchUrl;
    const primary = el.querySelector<HTMLAnchorElement>('[data-role="primary-link"]');
    if (primary) {
      if (latestVideoId) {
        primary.href = watchUrl;
        primary.textContent = isPastLive ? '📼 지난 라이브 다시보기' : '📼 최신 녹화 영상 시청';
      } else {
        primary.href = channelUrl;
        primary.textContent = '🎬 채널 홈 방문';
      }
    }
    const latestBtn = el.querySelector<HTMLAnchorElement>('[data-role="latest-link"]');
    if (latestBtn) {
      if (latestVideoId) {
        latestBtn.href = watchUrl;
        latestBtn.removeAttribute('hidden');
      } else {
        latestBtn.setAttribute('hidden', '');
      }
    }
    const status = el.querySelector<HTMLElement>('[data-role="status-line"]');
    if (status) {
      if (latestVideoId) {
        const labelKind = isPastLive ? '지난 라이브 다시보기' : '최신 녹화 영상';
        status.textContent = latestTitle
          ? `⚫ 현재 라이브 아님 — ${labelKind}: "${latestTitle}"`
          : `⚫ 현재 라이브 아님 — ${labelKind}으로 연결됩니다.`;
      } else {
        status.textContent = '⚫ 현재 라이브 아님 — 채널 홈으로 이동합니다.';
      }
    }
    const badge = el.querySelector<HTMLElement>('[data-role="header-badge"]');
    if (badge) badge.textContent = '📺 추천 채널 (오프라인)';
    el.classList.remove('is-live');
    applyInfoPanel(el, 'offline', detail, channel);
  }

  function applyUnknown(el: HTMLElement) {
    const channelUrl = el.dataset.channelUrl || '#';
    removeEmbedIframe(el);
    const placeholder = el.querySelector<HTMLElement>('[data-role="placeholder"]');
    if (placeholder) {
      placeholder.removeAttribute('hidden');
      placeholder.classList.remove('lc-placeholder-checking');
      placeholder.classList.add('lc-placeholder-offline');
    }
    const phIcon = el.querySelector<HTMLElement>('.lc-placeholder-icon');
    if (phIcon) phIcon.textContent = '📺';
    const phTitle = el.querySelector<HTMLElement>('[data-role="placeholder-title"]');
    if (phTitle) phTitle.textContent = '라이브 상태 확인 실패';
    const phSub = el.querySelector<HTMLElement>('[data-role="placeholder-sub"]');
    if (phSub) phSub.textContent = '채널 홈에서 현재 방송 여부와 최신 영상을 직접 확인하세요.';
    const phCta = el.querySelector<HTMLAnchorElement>('[data-role="placeholder-cta"]');
    if (phCta) {
      phCta.href = channelUrl;
      phCta.textContent = '🎬 채널 홈 방문';
      phCta.removeAttribute('hidden');
    }
    el.querySelector('[data-role="checking-pill"]')?.setAttribute('hidden', '');
    el.querySelector('[data-role="live-pill"]')?.setAttribute('hidden', '');
    const offlinePill = el.querySelector<HTMLElement>('[data-role="offline-pill"]');
    if (offlinePill) {
      offlinePill.textContent = '⚠️ 라이브 상태 확인 실패';
      offlinePill.removeAttribute('hidden');
    }
    const primary = el.querySelector<HTMLAnchorElement>('[data-role="primary-link"]');
    if (primary) {
      primary.href = channelUrl;
      primary.textContent = '🎬 채널 홈 방문';
    }
    const latestBtn = el.querySelector<HTMLAnchorElement>('[data-role="latest-link"]');
    if (latestBtn) latestBtn.setAttribute('hidden', '');
    const titleLink = el.querySelector<HTMLAnchorElement>('[data-role="title-link"]');
    if (titleLink) titleLink.href = channelUrl;
    const status = el.querySelector<HTMLElement>('[data-role="status-line"]');
    if (status) {
      status.textContent = '라이브 상태 확인 실패 — 채널 홈으로 이동합니다.';
    }
    el.classList.remove('is-live');
    applyInfoPanel(el, 'unknown', null, null);
  }

  async function refresh(el: HTMLElement) {
    const channelId = el.dataset.channelId;
    if (!channelId) {
      applyUnknown(el);
      return;
    }
    try {
      const result = await checkChannel(channelId);
      if (result.state === 'live') applyLive(el, result.videoId, result.detail, result.channel);
      else if (result.state === 'offline') applyOffline(el, result.latestVideoId, result.latestTitle, result.detail, result.channel);
      else applyUnknown(el);
    } catch (_err) {
      applyUnknown(el);
    }
  }

  function startElapsedTicker(el: HTMLElement) {
    const tick = () => {
      const startMs = Number(el.dataset.lcLiveStartMs);
      if (!startMs) return;
      const elapsedEl = el.querySelector<HTMLElement>('[data-role="elapsed-value"]');
      if (elapsedEl) elapsedEl.textContent = fmtElapsed(Date.now() - startMs);
    };
    tick();
    return window.setInterval(tick, 1000);
  }

  async function init() {
    const containers = document.querySelectorAll<HTMLElement>('.live-channel');
    for (const el of Array.from(containers)) {
      await refresh(el);
      startElapsedTicker(el);
      window.setInterval(() => { refresh(el); }, 60_000);
      const refreshBtn = el.querySelector<HTMLButtonElement>('[data-role="refresh-btn"]');
      if (refreshBtn) {
        refreshBtn.addEventListener('click', async () => {
          refreshBtn.disabled = true;
          try { await refresh(el); }
          finally { refreshBtn.disabled = false; }
        });
      }
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') refresh(el);
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
