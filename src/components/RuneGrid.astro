---
import ImageModal from './ImageModal.astro';
import type { Rune } from '../data/runes';

interface Props {
  runes: Rune[];
}
const { runes } = Astro.props as Props;
---

<div class="rune-grid">
  {runes.map((r) => (
    <article class={`rune-card rune-rarity-${r.rarity}`} aria-labelledby={`rune-${r.slug}-name`}>
      <div class="rune-card-icon">
        <ImageModal
          src={r.iconSrc}
          lightboxSrc={r.tooltipSrc}
          alt={`${r.name} 룬 — 인-게임 툴팁`}
          caption=""
          size={84}
        />
      </div>
      <div class="rune-card-body">
        <header class="rune-card-head">
          <h4 id={`rune-${r.slug}-name`} class="rune-card-name">
            {r.name} <span class="rune-card-cost">[{r.cost}]</span>
          </h4>
          <span class={`rune-badge rune-badge-${r.rarity}`}>{r.rarity === 'legendary' ? '전설' : r.rarity === 'rare' ? '희귀' : '마법'}</span>
        </header>
        <dl class="rune-card-meta">
          <div><dt>요구</dt><dd>{r.resource}</dd></div>
          <div><dt>조건</dt><dd>{r.trigger}</dd></div>
          <div><dt>효과</dt><dd>{r.effect}</dd></div>
          {r.cooldown && <div><dt>재사용</dt><dd>{r.cooldown}</dd></div>}
        </dl>
      </div>
    </article>
  ))}
</div>

<style>
  .rune-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 0.85rem;
    margin: 1.25rem 0;
  }
  .rune-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    padding: 0.75rem 0.9rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-left-width: 4px;
    border-radius: 4px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .rune-card:hover {
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
  }
  .rune-rarity-legendary { border-left-color: #d97c1f; }
  .rune-rarity-rare { border-left-color: #f5d447; }
  .rune-rarity-magic { border-left-color: #5a8cff; }

  .rune-card-icon { display: flex; align-items: flex-start; }
  .rune-card-icon :global(.img-thumb) { margin: 0; }

  .rune-card-body { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }
  .rune-card-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; }
  .rune-card-name {
    margin: 0;
    font-size: 1.05rem;
    color: var(--d4-gold, #eac333);
    border-bottom: none !important;
    padding-bottom: 0 !important;
  }
  .rune-card-cost { color: var(--sl-color-gray-3); font-size: 0.85em; font-weight: 500; }
  .rune-badge {
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    border: 1px solid currentColor;
    line-height: 1.2;
  }
  .rune-badge-legendary { color: #d97c1f; background: rgba(217, 124, 31, 0.1); }
  .rune-badge-rare { color: #f5d447; background: rgba(245, 212, 71, 0.1); }
  .rune-badge-magic { color: #5a8cff; background: rgba(90, 140, 255, 0.1); }

  .rune-card-meta { margin: 0; font-size: 0.85rem; line-height: 1.45; }
  .rune-card-meta div { display: grid; grid-template-columns: 4rem 1fr; gap: 0.5rem; margin: 0.15rem 0; }
  .rune-card-meta dt { color: var(--sl-color-gray-3); font-weight: 600; }
  .rune-card-meta dd { margin: 0; color: var(--sl-color-text, #e6dcc6); }

  /* Light theme */
  [data-theme='light'] .rune-card { background: rgba(0, 0, 0, 0.03); border-color: rgba(0, 0, 0, 0.12); }
  [data-theme='light'] .rune-card-name { color: #7a5a0a; }
  [data-theme='light'] .rune-card-cost { color: #5a4a2e; }
  [data-theme='light'] .rune-card-meta dt { color: #5a4a2e; }
  [data-theme='light'] .rune-card-meta dd { color: #2a1a08; }
  [data-theme='light'] .rune-rarity-legendary { border-left-color: #9a4a0a; }
  [data-theme='light'] .rune-rarity-rare { border-left-color: #8a6a0a; }
  [data-theme='light'] .rune-rarity-magic { border-left-color: #1f3a8a; }
  [data-theme='light'] .rune-badge-legendary { color: #9a4a0a; background: rgba(217, 124, 31, 0.18); }
  [data-theme='light'] .rune-badge-rare { color: #8a6a0a; background: rgba(245, 212, 71, 0.25); }
  [data-theme='light'] .rune-badge-magic { color: #1f3a8a; background: rgba(90, 140, 255, 0.18); }
</style>
